=5", "medios": ["Clarin.com", "Impacto Castex", "Telemundo Tampa (49)"], "coberturas": [{"medio": "Clarin.com", "url": "https://news.google.com/rss/articles/CBMi-_?oc=5", "fecha": "2026-09-17T13:04:07+00:00", "titulo": "Oficial | Florida prohíbe a los inmigrantes indocumentados estudiar en programas de formación profesional y escuelas técnicas"}, {"medio": "Impacto Castex", "url": "https://news.google.com/rss/articles/CBMiV0FVX3lxTFBfUUtWQ1ViZ0E5SzNKeFpKQks4WEZsbFVEd1dEbTJnZTl0NnJkUFY0V18wNkZkRXpDSzk2WHRleUdpcDFFQjNxTzh6MXFIU2pDS2NxanFwUQ?oc=5", "fecha": "2026-09-17T13:36:34+00:00", "titulo": "Oficial | Florida prohíbe a los inmigrantes indocumentados estudiar en programas de formación profesional y escuelas técnicas"}, {"medio": "Telemundo Tampa (49)", "url": "https://news.google.?oc=5", "fecha": "2026-09-17T22:30:41+00:00", "titulo": "Restricciones educativas para inmigrantes indocumentados en Florida"}], "velocidad": 3, "aceleracion": null, "trends": null, "horas": 10.4, "notas": 4, "otras_urls": ["https://news.google.com/rss/articles/CBMiV0FVX3lxTFBfUUtWQ1ViZ0E5SzNKeFpKQks4WEZsbFVEd1dEbTJnZTl0NnJkUFY0V18wNkZkRXpDSzk2WHRleUdpcDFFQjNxTzh6MXFIU2pDS2NxanFwUQ?oc=5", "https://news.google.com/rss/articles/CBMi-_?oc=5", "https://news.google.?oc=5"], "ejes": ["acceso_derechos", "estatus"], "region": "Norteamérica", "paises": ["US"], "paises_nombres": ["Estados Unidos"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 8, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": [], "actores": ["estado_nacional", "gobiernos_locales"], "etapa": "destino", "tipo": "normativa", "cobertura": 3, "confianza": 0.9, "tiene_fuente_primaria": false, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": ["indocumentados"], "termino_busqueda": "inmigrantes indocumentados", "angulo_sugerido": "Analizar el impacto de las restricciones educativas en el acceso de jóvenes migrantes a la formación", "nota": "Restricciones normativas al acceso a la educación para personas sin estatus regular.", "fuentes_texto": [{"medio": "Clarin.com", "dominio": "clarin.com", "url": "https://www.clarin.com/estados-unidos/oficial-florida-prohibe-inmigrantes-indocumentados-estudiar-programas-formacion-profesional-escuelas-tecnicas_0_FQlSRcE3q2.html", "texto": "La Junta de Educación de Florida dio un paso decisivo en l a restricción del acceso educativo para la población migrante al aprobar una normativa que prohíbe a los estudiantes sin estatus migratorio legal matricularse en programas de educación técnica y formación profesional postsecundaria. La decisión alinea los centros de capacitación en oficios y las escuelas de adultos con las severas limitaciones impuestas semanas atrás en las doce universidades públicas del estado.\n\nLa modificación reglamentaria establece que únicamente los ciudadanos estadounidenses o las personas con residencia legal en el país podrán acceder a certificaciones profesionales, programas de aprendizaje, diplomaturas en tecnología aplicada y formatos de doble titulación en los distritos escolares. La prohibición golpea de forma directa las perspectivas de desarrollo de aproximadamente 8.000 estudiantes indocumentados que se gradúan anualmente de las escuelas secundarias de Florida.\n\nDesde el Departamento de Educación de Florida argumentaron que la medida busca unificar los criterios de admisión en todo el sistema estatal. Autoridades del área de Educación Profesional y para Adultos señalaron que la intención oficial es trasladar el estándar estricto aplicado en la educación universitaria hacia los programas técnicos de los distritos, impidiendo que fondos o estructuras públicas alberguen a residentes sin papeles.\n\nLa resolución generó un rechazo inmediato por parte de organizaciones civiles y sindicatos docentes como la United Faculty of Florida y la Florida Education Association. Los portavoces del sector advirtieron que esta barrera legal frena el crecimiento económico regional y cierra oportunidades en momentos donde el estado enfrenta una severa escasez de personal en la atención médica, la educación, la mecánica y los servicios eléctricos.\n\nEl escenario actual representa una ruptura drástica con la orientación política que tuvo el estado años atrás. En 2014, bajo la gestión del entonces gobernador Rick Scott y con el respaldo de amplios sectores legislativos, Florida había promulgado leyes para permitir que los estudiantes indocumentados criados en el estado pagaran tarifas universitarias locales . Con la reciente derogación de esas exenciones y la aprobación de este nuevo veto a la formación técnica, la administración estatal consolida un giro restrictivo en el acceso a la educación pública.\n\nRecibí en tu mail todas las noticias, historias y análisis de los periodistas de Clarín", "ok": true}, {"medio": "Telemundo Tampa (49)", "dominio": "telemundo49.com", "url": "https://www.telemundo49.com/video/historias-destacadas/restricciones-educativas-para-inmigrantes-indocumentados-en-florida/2412857/", "texto": "Restricciones educativas para inmigrantes indocumentados en Florida &#8211; Telemundo Tampa (49) Saltar al contenido Historias Destacadas Restricciones educativas para inmigrantes indocumentados en Florida Cerrar menú Inicia tu sesión / Regístrate Panel Búsqueda por: Newsletters Nuestros estándares de noticias Conoce a Telemundo Tampa Noticias Locales Promociones Fort Myers y Naples MÁS NOTICIAS PUERTO RICO ESTADOS UNIDOS Elecciones CUBA INMIGRACIÓN México MUNDO SALUD El tiempo Tráfico Responde Contáctanos MULTIMEDIA Términos de Servicio WRMD Public Inspection File Accesibilidad Empleos Aplicaciones de la FCC Envía tus comentarios Política de Privacidad No venda mi información personal Aviso de California Opciones de anuncios Anúnciate con nosotros / Advertise with us Guía de programación Síguenos Facebook Instagram Youtube Contáctanos", "ok": true}]}, {"id": "fae7a520fe15", "ti