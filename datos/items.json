{"generado": "2026-09-21T19:53:29+00:00", "clasificado": true, "notas_totales": 232, "items": [{"id": "8e2e4a6e7916", "titulo_original": "ICE dispara a migrante venezolano en Austin, Texas; hombre queda herido de gravedad", "url": "https://news.google.?oc=5", "medios": ["CiudadCCS", "Diario Las Américas", "Diario Tiempo de Honduras", "DSN Noticias", "Ecuavisa", "El Economista", "El Horizonte", "El Imparcial", "El Mundo", "EL PAÍS", "El Pitazo", "El Universal", "elespectador.com", "ElHeraldo.hn", "La FM", "La Voz de Galicia", "laopinion.com", "N+", "NOSTÁLGICA cl", "PostaMx", "Prensa Oriente", "Proyecto Puente", "Revista GENTE", "sdpnoticias", "tvn-2.com"], "coberturas": [{"medio": "CiudadCCS", "url": "https://news.google.com/rss/articles/CBMingFBVV95cUxPX1ZhcDB0Z3Q4TXVtam9hQ1BFTS1XTHNQZHlLQXBlaF9vd0VsVmtIRkFoYW5VZ09aUEtWbnMwN2hHN3hkUG5mMzVpY2Zsd0d1eEo0UGZhTXNkY0pyLUNqS2JkU0UyWVVOLTF2ZVM0dFZSUF9nVzRybkNCVUpOckJYUXJSamo5bUxTXzhYeFRsbDdTSjV1SWRQMzlYSUJjQQ?oc=5", "fecha": "2026-09-21T16:34:40+00:00", "titulo": "Agente del ICE dispara e hiere a migrante venezolano"}, {"medio": "Diario Las Américas", "url": "https://news.google.?oc=5", "fecha": "2026-09-21T13:08:00+00:00", "titulo": "ICE hiere de gravedad a otro inmigrante en Texas, es un joven venezolano"}, {"medio": "Diario Tiempo de Honduras", "url": "https://news.google.com/rss/articles/CBMilAFBVV95cUxNaEY1TlRJYkZManpIVDdMVUR6M1JaRnl3SGNxYUhtMWZVN2tmdEtQLTl3UlM0WUFDcUlIVU93MEVpRmNubmNJVW1jdF8tZ0dyY2lTeW1MTDJhSUtpRDFfMHVnZXgtSGtYSERhNUJMOVpIRmF5MUtlcmdwWTdZdjhQSTZ2aDEtbGdMcGhjdXFfbUxSeFlR?oc=5", "fecha": "2026-09-20T23:17:31+00:00", "titulo": "Caravana migrante sale de la terminal de SPS rumbo a Estados Unidos"}, {"medio": "DSN Noticias", "url": "https://news.google.com/rss/articles/CBMiwgFBVV95cUxNMTNsazdBTVBUSmlyUDEtREJnNzE1Ullpc1U3ZzNwZkJIUUEzVThCTmc5RXN5SmNLZDVNeFRjbWNSd1pjMU51bEFIWlZnZEVucjZ6QV9VSHNmaUUwLW5HUS1iVm84RGUybHBnbjBrZFItOE9mM2dScGtPUUx2UFhGOGlHWW9RM0UyRU9sSjlGNjl2ZG9xRllSSHkwemo5MklUcFNma3JwYlVuZkZ5UWV4