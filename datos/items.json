ws.google.?oc=5", "fecha": "2026-10-05T13:07:40+00:00", "titulo": "Capturan en Antioquia a alias ‘Lobo’, presunto cabecilla del frente 36 de las disidencias de las Farc"}, {"medio": "Infobae", "url": "https://news.google.?oc=5", "fecha": "2026-10-05T15:28:28+00:00", "titulo": "Golpe a las disidencias de “Calarcá” en Antioquia: fueron capturados dos cabecillas, alias Lobo y alias Samanta"}], "velocidad": 2, "aceleracion": null, "trends": null, "horas": 12.6, "notas": 2, "otras_urls": ["https://news.google.?oc=5"], "ejes": ["exilio"], "region": "Sudamérica", "paises": ["CO"], "paises_nombres": ["Bolivia", "Colombia", "Ecuador"], "pais_inferido": true, "fuera_de_alcance": false, "importancia": 2, "clasificado": true, "es_migratorio": false, "poblaciones": [], "colectividades": ["CO"], "actores": [], "etapa": null, "tipo": "caso", "cobertura": 6, "confianza": 0.8, "tiene_fuente_primaria": false, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": null, "angulo_sugerido": null, "nota": "Captura de actores armados locales en Colombia. Sin vínculo migratorio."}, {"id": "e68abc6cb9e4", "titulo_original": "Alerta máxima inmigrantes legales e indocumentados | Incrementan operativos del ICE en este popular distrito de EE.UU. tras cancelación de TPS para haitianos", "url": "https://news.google.?oc=5", "medios": ["Diario Libero", "La República"], "coberturas": [{"medio": "Diario Libero", "url": "https://news.google.?oc=5", "fecha": "2026-10-05T02:47:52+00:00", "titulo": "ALERTA MÁXIMA, inmigrantes legales e indocumentados en EE. UU.: DEMANDAN al ICE por presuntos ABUSOS en un centro de detención de este ESTADO NO SANTUARIO"}, {"medio": "La República", "url": "https://news.google.?oc=5", "fecha": "2026-10-05T18:29:09+00:00", "titulo": "Alerta máxima inmigrantes legales e indocumentados | Incrementan operativos del ICE en este popular distrito de EE.UU. tras cancelación de TPS para haitianos"}], "velocidad": 2, "aceleracion": null, "trends": null, "horas": 22.9, "notas": 10, "otras_urls": ["https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5"], "ejes": ["deportaciones", "asilo", "estatus"], "region": "Regional", "paises": ["US"], "paises_nombres": ["Estados Unidos", "Haití"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 9, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": ["HT"], "actores": ["organismos_migratorios"], "etapa": "destino", "tipo": "normativa", "cobertura": 6, "confianza": 0.95, "tiene_fuente_primaria": true, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": ["indocumentados"], "termino_busqueda": "TPS haitianos", "angulo_sugerido": "Impacto de la cancelación del TPS en la vulnerabilidad de la comunidad haitiana", "nota": "Incremento de operativos de ICE tras cancelación de TPS para haitianos.", "fuentes_texto": [{"medio": "La República", "dominio": "larepublica.pe", "url": "https://larepublica.pe/latinos-en-usa/2026/10/05/alerta-maxima-inmigrantes-legales-e-indocumentados-incrementan-operativos-del-ice-en-este-popular-distrito-de-eeuu-tras-cancelacion-de-tps-para-haitianos-228225", "texto": "Latinos en USA Alerta máxima inmigrantes legales e indocumentados | Incrementan operativos del ICE en este popular distrito de EE.UU. tras cancelación de TPS para haitianos Las organizaciones de derechos civiles recomiendan a inmigrantes buscar asistencia legal gratuita ante el incremento de agentes del ICE en diversos sectores. Incrementan operativos del ICE en este popular distrito de EE.UU. | Composición larepublica.pe | Nicole Gonzales Por Nicole Gonzales Lunes 05 de Octubre del 2026 · 13:29h La República en Google Resumen Escuchar Compartir El último 1 de octubre, se registró un aumento repentino de agentes del Servicio de Control de Inmigración y Aduanas (ICE) en Flatbush, Brooklyn, que es un barrio muy concurrido por tener una mayor concentración de inmigrantes provenientes del Caribe en la ciudad de Nueva York. Esto fue reportado por diversos activistas y residentes de la nación estadounidense.\n\nPuedes ver Gran noticia para inmigrantes en EE.UU. | Proponen eliminar al ICE para proteger a indocumentados\n\nLos activistas de la coalición Hands Off NYC revelaron que vieron operaciones de agentes migratorios que se llevaron a cabo en el área de Cortelyou y East 35th Street del 28 de septiembre al 1 de octubre, según una publicación hecha en redes sociales.\n\nPor su parte, los coordinadores de la organización cultural Little Caribbean informaron que el viernes en la mañana se registró la presencia de agentes migratorios en las zonas de Lenox Road, Linden Boulevard y Belford Avenue.\n\nCabe mencionar que los mencionados avistamientos de los oficiales se producen dos meses después de que se cancelara el Estatus de Protección Temporal (TPS) para los haitianos en EE.UU. El distrito de Flatbush alberga además una de las mayores poblaciones de haitianos en el país.\n\n&quot;Flatbush es una comunidad de inmigrantes. Estas familias están presentes en cada manzana, en cada escuela y en cada pequeño negocio de Flatbush Avenue&quot;, expresó la concejala Rita Joseph. &quot;Acciones coercitivas como estas siembran el miedo en todo el vecindario. Hacen que la gente tenga miedo de ir a trabajar, llevar a sus hijos a la escuela o buscar ayuda cuando la necesita. Eso no hace que nadie esté más seguro&quot;, agregó.\n\nEn el mes de agosto, activistas y funcionarios electos se manifestaron contra el aumento de medidas de control migratorio del ICE en distintos barrios de Queens, sobre todo en zonas donde los inmigrantes representaban el 50% o más de la población.\n\nSe conoció que una persona fue arrestada por el ICE en medio del operativo, según lo revelado por la autoridad Joseph. Es por ello que su oficina ofreció asistencia legal a la familia de esta persona, de acuerdo a lo informado por PIX 11.\n\n&quot;En coordinación con mi oficina, Hands Off NYC recorrió el vecindario y deslizó folletos de ‘Conozca sus derechos’ por debajo de todas las puertas a las que pudieron llegar, para que nuestros vecinos sepan qué hacer si los agentes se les acercan&quot;, sostuvo Joseph en un comunicado.", "ok": true}, {"medio": "Diario Libero", "dominio": "libero.pe", "url": "https://libero.pe/estados-unidos/2026/10/04/alerta-maxima-inmigrantes-legales-indocumentados-en-estados-unidos-demandan-ice-presuntos-abusos-en-centro-de-detencion-de-estado-santuario-ee-uu-usa-lbeu-275484", "texto": "0 Últimas noticias Fútbol Peruano F. Internacional Deportes Ocio ESTADOS UNIDOS VIDEOS TEC LÍBERO Tiempo Extra Estados Unidos Inmigrantes ALERTA MÁXIMA, inmigrantes legales e indocumentados en EE. UU.: DEMANDAN al ICE por presuntos ABUSOS en un centro de detención de este ESTADO NO SANTUARIO Organizaciones civiles demandaron al ICE por presunto hacinamiento, atención médica deficiente y restricciones de comunicación en un centro de Florida.\n\nMaría Zapata Actualizado el 4 Oct. 2026 | 22:39 H Demandan al ICE por presuntos abusos en un centro de detención de inmigrantes en Florida. | Composición: María Zapata | Líbero COMPARTIR Siguenos en Google News Una nueva demanda pone en cuestionamiento las condiciones en las que permanecen detenidos algunos inmigrantes en Estados Unidos . De acuerdo con La Opinión , organizaciones defensoras de los derechos civiles denunciaron presuntos abusos en el centro de procesamiento de Miramar, en Florida , y señalaron al ICE como responsable de las condiciones denunciadas.\n\nPUEDES VER: ALERTA MÁXIMA, inmigrantes legales e indocumentados en EE. UU.: ICE arrestó a más de 48.000 extranjeros en septiembre, ¿A CUÁNTOS MANTIENE bajo custodia ahora?\n\nEl Centro Legal para la Pobreza del Sur (SPLC) y Americanos por la Justicia para los Inmigrantes (AI Justice) encabezan la demanda presentada contra el ICE por el trato que recibirían los inmigrantes indocumentados trasladados al centro de procesamiento de Miramar.\n\nSegún la querella citada por La Opinión , algunos detenidos habrían permanecido más tiempo del permitido por la ley y en condiciones de hacinamiento . Además, se denunció un acceso limitado a las duchas, alimentación insuficiente y falta de personal médico para atender posibles emergencias.\n\nLa denuncia sostiene, además, que los inmigrantes tendrían dificultades para recibir visitas de sus abogados o comunicarse con sus familiares. Estas restricciones dificultarían que algunas personas conozcan o informen con facilidad sobre su situación mientras esperan una decisión sobre su caso migratorio.\n\nSui Chung, directora ejecutiva de AI Justice, cuestionó las condiciones denunciadas y afirmó que la detención no debería implicar la pérdida de derechos básicos. La Opinión recogió sus declaraciones sobre el caso.\n\nPor su parte, A. J. Hernández, subdirector de Justicia para Inmigrantes del SPLC, calificó el lugar como denigrante y potencialmente peligroso. Según su organización, el recinto no habría sido diseñado para funcionar como centro de detención del ICE y tampoco contaría con los recursos necesarios.\n\nLas organizaciones pidieron al tribunal que ordene al ICE dejar de utilizar Miramar con ese propósito y que garantice condiciones básicas para las personas detenidas. El caso vuelve a poner el foco en el trato que reciben los inmigrantes en Estados Unidos , incluidos aquellos en situación irregular, mientras permanecen bajo custodia migratoria en Florida, un estado que no ofrece protección de santuario.\n\nRedactora en la web del Diario Líbero, sección Ocio y México. Egresada de Comunicación y Periodismo (UPC) con 2 años de experiencia en contenido digital. Interesada en anime, tecnología y crónicas.\n\nCineplanet: 2 Entradas 2D + 2 Bebidas Grandes + Pop corn gigante. Lunes a Domingo\n\nFlying Squirrel: Full Day, 60 o 120 minutos según elijas en Jockey Plaza, San Miguel e Independencia.\n\nBuffet Almuerzo o Cena + Postres + 1 Bebida ( Ice Tea ) en cualquiera de sus 4 locales\n\nREVISION TECNICA VEHICULAR FARENET. Locales a elegir. Lunes a Domingo.", "ok": true}]}, {"id": "21095177694d", "titulo_original": "“Asistimos a la ironización de un término poderoso: ‘antisemitismo’; se utiliza indebidamente para justificar acciones de un gobierno israelí de derecha”", "url": "https://news.google.?oc=5", "medios": ["El Universal"], "coberturas": [{"medio": "El Universal", "url": "https://news.google.?oc=5", "fecha": "2026-10-06T00:23:22+00:00", "titulo": "“Asistimos a la ironización de un término poderoso: ‘antisemitismo’; se utiliza indebidamente para justificar acciones de un gobierno israelí de derecha”"}], "velocidad": 1, "aceleracion": null, "trends": null, "horas": 1.3, "notas": 1, "otras_urls": [], "ejes": ["medios"], "region": "Norteamérica", "paises": [], "paises_nombres": ["Estados Unidos"], "pais_inferido": true, "fuera_de_alcance": false, "importancia": 1, "clasificado": true, "es_migratorio": false, "poblaciones": [], "colectividades": [], "actores": [], "etapa": null, "tipo": "discurso", "cobertura": 2, "confianza": 0.8, "tiene_fuente_primaria": false, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": null, "angulo_sugerido": null, "nota": "Discusión sobre antisemitismo y política internacional. Sin relación con migraciones."}, {"id": "3b583fea876a", "titulo_original": "Guardia Costera rescata a 61 personas de embarcación cerca de República Dominicana", "url": "https://news.google.?oc=5", "medios": ["Primera Hora"], "coberturas": [{"medio": "Primera Hora", "url": "https://news.google.?oc=5", "fecha": "2026-10-06T00:11:37+00:00", "titulo": "Guardia Costera rescata a 61 personas de embarcación cerca de República Dominicana"}