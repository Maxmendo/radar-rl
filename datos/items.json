fianza": 0.9, "tiene_fuente_primaria": false, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": null, "angulo_sugerido": null, "nota": "Nota policial sobre un actor armado; no trata centralmente sobre movilidad humana."}, {"id": "c8c5dd69a703", "titulo_original": "California: el DHS compra tres centros de detención migratoria por US$950 millones", "url": "https://news.google.com/rss/articles/CBMikAFBVV95cUxQMVFpVjl6bXhkLVdaOGJ5TUFzN25XTEw0RVhGZmZfcTlEaUFVS1plSEh0b3RYaktvUURrNWpSUnphV0NRNXJzMmpSMldwXzBkMzN0YWlZQjBmOHd4dEJPUHdVNzF2VVVuZjVaaThuT285MzdiWTRfNEdqTkFjeG9iWmE3elVZNjlFcFdzSjZ2elQ?oc=5", "medios": ["Directorio Cubano", "El Canal de las Noticias", "La Nación", "Notigram"], "coberturas": [{"medio": "Directorio Cubano", "url": "https://news.google.com/rss/articles/CBMikAFBVV95cUxQMVFpVjl6bXhkLVdaOGJ5TUFzN25XTEw0RVhGZmZfcTlEaUFVS1plSEh0b3RYaktvUURrNWpSUnphV0NRNXJzMmpSMldwXzBkMzN0YWlZQjBmOHd4dEJPUHdVNzF2VVVuZjVaaThuT285MzdiWTRfNEdqTkFjeG9iWmE3elVZNjlFcFdzSjZ2elQ?oc=5", "fecha": "2026-10-06T05:25:23+00:00", "titulo": "Estados Unidos compra tres centros de detención en California por 950 millones de dólares"}, {"medio": "El Canal de las Noticias", "url": "https://news.google.com/rss/articles/CBMiiwFBVV95cUxPSGFQQUdKZmJHLU5ybnBuRmtvVHVzQmd1X2xZdDlrRkNxOGp6U3l4YVFFcnFRVVRmSENzTTd3a25UVFRXVXVad0dmSGZ5Z0kwZHNLYXR1MmtUc2hRZXFTQkVCeFhjTkloU0N4VFdxMjFTaWQ4ZkQtei1xbUExRFhkOVR6WkVLelNvX2k4?oc=5", "fecha": "2026-10-06T02:03:47+00:00", "titulo": "Gobierno de Trump adquiere tres centros mas de detención para migrantes"}, {"medio": "La Nación", "url": "https://news.google.?oc=5", "fecha": "2026-10-06T17:10:00+00:00", "titulo": "California: el DHS compra tres centros de detención migratoria por US$950 millones"}, {"medio": "Notigram", "url": "https://news.google.?oc=5", "fecha": "2026-10-06T15:52:56+00:00", "titulo": "EU compra tres centros de detención para migrantes en California por 950 mdd"}], "velocidad": 4, "aceleracion": null, "trends": null, "horas": 22.5, "notas": 4, "otras_urls": ["https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.com/rss/articles/CBMiiwFBVV95cUxPSGFQQUdKZmJHLU5ybnBuRmtvVHVzQmd1X2xZdDlrRkNxOGp6U3l4YVFFcnFRVVRmSENzTTd3a25UVFRXVXVad0dmSGZ5Z0kwZHNLYXR1MmtUc2hRZXFTQkVCeFhjTkloU0N4VFdxMjFTaWQ4ZkQtei1xbUExRFhkOVR6WkVLelNvX2k4?oc=5"], "ejes": ["deportaciones", "securitizacion"], "region": "Norteamérica", "paises": ["US"], "paises_nombres": ["Estados Unidos"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 9, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": [], "actores": ["estado_nacional", "organismos_migratorios", "empresas"], "etapa": "destino", "tipo": "evento", "cobertura": 6, "confianza": 0.95, "tiene_fuente_primaria": false, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "centros de detencion", "angulo_sugerido": "Analizar la expansión del negocio de la detención migratoria y su impacto en los derechos humanos", "nota": "Expansión de la infraestructura de detención migratoria con fuerte impacto presupuestario y de derechos.", "fuentes_texto": [{"medio": "La Nación", "dominio": "lanacion.com.ar", "url": "https://www.lanacion.com.ar/estados-unidos/california/california-el-dhs-compra-tres-centros-de-detencion-migratoria-por-us950-millones-nid06102026/", "texto": "Inicio Secciones Foodit Club LN Mi cuenta LN 104.9 + Música Últimas noticias Tránsito y transporte Clima LA NACION Data Política Economía Futuria Dólar Hoy Campo Propiedades Comercio Exterior Movilidad Índices El Mundo Estados Unidos Sociedad Buenos Aires Seguridad Educación Cultura Comunidad Bienestar Ciencia Hablemos de todo Opinión Editoriales Columnistas Cartas de Suscriptores Deportes Fútbol Rugby Tenis Canchallena Lifestyle LN Juegos Turismo Tecnología Horóscopo Feriados Loterías y quinielas Podcasts Moda y Belleza Espectáculos Qué sale? Cartelera de cine Cartelera de teatro Edición Impresa Acceso PDF Editoriales Avisos fúnebres Avisos sociales Carta de lectores Conversaciones de domingo Sábado Ideas Revistas Revista OHLALÁ! Revista ¡HOLA! Revista Lugares Revista Living Revista Rolling Stone Revista Jardín LN Juegos Suscriptores Mis notas Club LA NACION canchallena Foodit Bonvivir LN 104.9 + Música LN+ Kiosco LA NACION LA NACION &gt; California California: el DHS compra tres centros de detención migratoria por US$950 millones Las instalaciones de Adelanto suman 2644 camas y GEO Group continuará a cargo de las operaciones hasta 2034 6 de octubre de 2026 14:10 3 minutos de lectura &#x27; LA NACION Agregar LA NACION en El Adelanto ICE Processing Center forma parte de las tres instalaciones de detención migratoria adquiridas por el DHS por US$950 millones. Fotomontaje editado con IA Agregar en El gobierno de Estados Unidos compró el 5 de octubre tres centros de detención en Adelanto , California , por 950 millones de dólares . Las instalaciones quedarán bajo la propiedad del Departamento de Seguridad Nacional ( DHS , por sus siglas en inglés) mientras GEO Group mantiene la gestión de las operaciones.\n\nDe acuerdo con un comunicado oficial de GEO Group , la operación incluye tres instalaciones que forman parte del complejo de detención de Adelanto .\n\nAunque el DHS tendrá la propiedad de los centros de detención, GEO Group continuará con la operación Geo Group Los centros son:\n\nEn total, los tres establecimientos tienen capacidad para 2644 personas . GEO Group, que le vendió los centros al DHS , informó que espera recibir aproximadamente US$705 millones netos después de impuestos, comisiones y otros gastos asociados a la operación.\n\nLa compañía mantendrá la prestación de servicios bajo su contrato vigente con el Servicio de Inmigración y Control de Aduanas de Estados Unidos ( ICE , por sus siglas en inglés), cuya vigencia se extiende hasta el 19 de diciembre de 2034 .\n\nDe acuerdo con Los Angeles Times , la adquisición se produce mientras California refuerza los controles sobre los centros de detención migratoria que funcionan en el estado. El 29 de septiembre, el gobernador Gavin Newsom firmó 21 leyes vinculadas con inmigración, transparencia y supervisión de estas instalaciones.\n\nEntre las medidas figura un impuesto del 25% a los centros privados de detención , además de nuevos requisitos de salud, seguridad, acceso a registros públicos y supervisión estatal.\n\nGEO Group, propiedad de George Zoley, es el mayor contratista del ICE The GEO Group y Archivo Según el medio, la compra de instalaciones privadas forma parte de una estrategia del gobierno de Donald Trump para reducir el alcance de la supervisión estatal y local , aunque las empresas privadas continúen en la operación.\n\nEl complejo de Adelanto fue objeto de denuncias y acciones judiciales por las condiciones en las que permanecen los inmigrantes detenidos. Organizaciones de derechos de los inmigrantes presentaron una demanda colectiva federal en la que denunciaron problemas con el agua potable, la alimentación, el saneamiento y la atención médica.\n\nUn juez federal ordenó implementar mejoras a partir de estas presentaciones. Según registros del DHS citados por Los Angeles Times , cuatro personas murieron en la instalación desde 2025 .\n\nUna revisión de mortalidad del ICE sobre el caso de Ismael Ayala-Uribe, migrante de 39 años fallecido bajo custodia federal, concluyó que ", "ok": true}, {"medio": "Directorio Cubano", "dominio": "directoriocubano.info", "url": "https://www.directoriocubano.info/usa/compra-centros-detencion-california-950-millones/", "texto": "[K!3\u0012!c \u0000\u0000�����\u0001ړV�\u000f\u0001ԑ���Ͽ�\u0012\u0018 \u0013�\u000fӲ �������j��[��M��\u0014�B\u0011@ͤɴ,ɱ\u0012�V$�N:��A\u0015n���� ��`��w�?�\"� �0i���濿�W�˙D���'��9��s\"\u0001\u0015\u0005�\u0002�HYc��3�q�\u001a� ��\u0006\u001a\u000f B$���A������M\u0015e\u001bD�