.0, "notas": 1, "otras_urls": [], "ejes": ["medios"], "region": "Norteamérica", "paises": [], "paises_nombres": ["Estados Unidos"], "pais_inferido": true, "fuera_de_alcance": false, "importancia": 1, "clasificado": true, "es_migratorio": false, "poblaciones": [], "colectividades": [], "actores": ["medios"], "etapa": null, "tipo": "servicio", "cobertura": null, "confianza": 0.9, "tiene_fuente_primaria": false, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": null, "angulo_sugerido": null, "nota": "Agenda o sumario de agencia de noticias sin contenido migratorio específico."}, {"id": "26ccb5c67bf8", "titulo_original": "ALERTA MÁXIMA, inmigrantes legales e indocumentados en EE. UU.: ICE recibiría la orden de endurecer sus redadas y ELEVAR las DETENCIONES DIARIAS a esta cifra", "url": "https://news.google.?oc=5", "medios": ["Diario Libero"], "coberturas": [{"medio": "Diario Libero", "url": "https://news.google.?oc=5", "fecha": "2026-10-09T15:23:27+00:00", "titulo": "ALERTA MÁXIMA, inmigrantes legales e indocumentados en EE. UU.: ICE recibiría la orden de endurecer sus redadas y ELEVAR las DETENCIONES DIARIAS a esta cifra"}], "velocidad": 1, "aceleracion": null, "trends": null, "horas": 9.3, "notas": 3, "otras_urls": ["https://news.google.?oc=5", "https://news.google.?oc=5"], "ejes": ["deportaciones", "securitizacion"], "region": "Norteamérica", "paises": ["US"], "paises_nombres": ["Estados Unidos"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 9, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": [], "actores": ["organismos_migratorios"], "etapa": "destino", "tipo": "evento", "cobertura": 5, "confianza": 0.9, "tiene_fuente_primaria": false, "contiene_datos_personales": false, "requiere_verificacion": true, "cobertura_tardia": false, "terminologia_problematica": ["indocumentados"], "termino_busqueda": "deportaciones", "angulo_sugerido": "Verificar con fuentes oficiales si existen órdenes formales de incremento de detenciones", "nota": "Anuncio de endurecimiento de operativos y detenciones masivas por parte de ICE.", "fuentes_texto": [{"medio": "Diario Libero", "dominio": "libero.pe", "url": "https://libero.pe/estados-unidos/2026/10/09/alerta-maxima-inmigrantes-legales-indocumentados-en-estados-unidos-ice-recibiria-orden-de-endurecer-sus-redadas-elevar-detenciones-diarias-cifra-ee-uu-usa-lbeu-352539", "texto": "0 Últimas noticias Fútbol Peruano F. Internacional Deportes Ocio ESTADOS UNIDOS VIDEOS TEC LÍBERO Tiempo Extra EN VIVO Universitario vs. Sancor por la Noche de las Pumas 2026 Estados Unidos Inmigrantes ALERTA MÁXIMA, inmigrantes legales e indocumentados en EE. UU.: ICE recibiría la orden de endurecer sus redadas y ELEVAR las DETENCIONES DIARIAS a esta cifra ICE tendría como objetivo detener a 3.000 inmigrantes al día en EE. UU., pese a que la Administración niega la existencia de cuotas oficiales de arrestos .\n\nMaría Zapata Actualizado el 9 Oct. 2026 | 16:47 H ICE habría ordenado a sus agentes elevar a 3.000 los arrestos diarios. | Composición: María Zapata | Líbero COMPARTIR Siguenos en Google News El Servicio de Inmigración y Control de Aduanas de Estados Unidos ( ICE ) tendría previsto aumentar a 3.000 el número de arrestos diarios de inmigrantes , lo que representa un incremento del 50 % respecto al promedio reciente de la agencia. La nueva medida, transmitida verbalmente el martes 6 de octubre, apuntaría a intensificar los operativos migratorios en todo el país, según informó CNN en una noticia retomada por Periódico Cubano .\n\nPUEDES VER: ALERTA MÁXIMA, inmigrantes legales e indocumentados en EE. UU.: operativo de ICE DURARÁ 45 DÍAS en ESTE ESTADO y arrestaría a &quot;cualquiera&quot;, según fuentes\n\nDe acuerdo con dos fuentes consultadas por CNN , la dirección de ICE habría solicitado a sus agentes realizar 1.000 detenciones adicionales al día para alcanzar la meta de 3.000 arrestos diarios . Además, la agencia buscaría llegar a las 19.000 detenciones semanales, teniendo en cuenta que los operativos suelen disminuir durante los fines de semana.\n\nEl objetivo retoma una exigencia impulsada anteriormente por la Casa Blanca, que ICE había tenido dificultades para cumplir de manera sostenida. Hasta hace poco, la agencia registraba alrededor de 2.000 arrestos diarios, por lo que la nueva meta supondría un aumento considerable de las operaciones contra inmigrantes indocumentados.\n\nLa medida se produce en medio de una creciente presión sobre los funcionarios migratorios del Gobierno de Donald Trump para intensificar las operaciones destinadas a localizar y detener a extranjeros sujetos a deportación. En paralelo, ICE solicitó ampliar la capacidad de sus centros de detención ante el incremento de las operaciones migratorias.\n\nPese a la directriz reportada, el Departamento de Seguridad Nacional (DHS) negó que existan cuotas obligatorias para los agentes migratorios. Un portavoz de la institución declaró a CNN : &quot;No existen cuotas de arrestos&quot;.\n\nPor su parte, el secretario de Seguridad Nacional, Markwayne Mullin, también negó haber recibido instrucciones de la Casa Blanca para establecer objetivos numéricos de detenciones. Sus declaraciones contrastan con los reportes sobre la nueva meta que ICE buscaría alcanzar en Estados Unidos.\n\nLas cifras reflejan un aumento de las detenciones migratorias. En agosto, ICE registró aproximadamente 51.000 arrestos, frente a los 46.000 reportados en julio. Entre enero y agosto, el total alcanzó las 262.768 personas detenidas, según los datos citados en el informe.\n\nPor ahora, la información sobre la meta de 3.000 arrestos diarios se basa en fuentes anónimas consultadas por CNN . Por ello, este objetivo debe distinguirse de una cuota oficial reconocida por el DHS. La posible intensificación de las operaciones migratorias mantiene la atención sobre los inmigrantes en Estados Unidos, especialmente quienes podrían enfrentar procesos de detención y deportación.\n\nRedactora en la web del Diario Líbero, sección Ocio y México. Egresada de Comunicación y Periodismo (UPC) con 2 años de experiencia en contenido digital. Interesada en anime, tecnología y crónicas.\n\nCineplanet: 2 Entradas 2D + 2 Bebidas Grandes + Pop corn gigante. Lunes a Domingo\n\nFlying Squirrel: Full Day, 60 o 120 minutos según elijas en sus 3 locales\n\nBuffet Almuerzo o Cena + Postres + 1 Bebida ( Ice Tea ) en cualquiera de sus 4 lo", "ok": true}]}, {"id": "472500b3d3fd", "titulo_original": "Chile facilita la contratación de trabajadores migrantes para la campaña agrícola 2026-2027", "url": "https://news.google.?oc=5", "medios": ["https://www.hortidaily.es/"], "coberturas": [{"medio": "https://www.hortidaily.es/", "url": "https://news.google.?oc=5", "fecha": "2026-10-09T15:15:00+00:00", "titulo": "Chile facilita la contratación de trabajadores migrantes para la campaña agrícola 2026-2027"}], "velocidad": 1, "aceleracion": null, "trends": null, "horas": 9.4, "notas": 1, "otras_urls": [], "ejes": ["trabajo", "estatus"], "region": "Sudamérica", "paises": ["CL"], "paises_nombres": ["Chile"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 7, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": [], "actores": ["estado_nacional", "empresas"], "etapa": "destino", "tipo": "normativa", "cobertura": 2, "confianza": 0.9, "tiene_fuente_primaria": true, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "trabajadores temporales", "angulo_sugerido": "Analizar las garantías laborales y de contratación para la temporada agrícola", "nota": "Medida estatal para facilitar la contratación de trabajadores migrantes estacionales."}, {"id": "38f1f2e2ae9f", "titulo_original": "De 22,000 a 3,000: Miami-Dade se queda sin alumnos inmigrantes", "url": "https://news.go