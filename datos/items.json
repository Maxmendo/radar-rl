dad": 3, "aceleracion": null, "trends": null, "horas": 7.5, "notas": 3, "otras_urls": ["https://news.google.?oc=5", "https://news.google.?oc=5"], "ejes": ["asilo"], "region": "Sudamérica", "paises": ["BO", "CO", "EC"], "paises_nombres": ["Bolivia", "Colombia", "Ecuador"], "pais_inferido": true, "fuera_de_alcance": true, "importancia": null, "clasificado": false}, {"id": "5d9e7326075e", "titulo_original": "EE UU localizará en el extranjero a migrantes deportados para cobrarles multas pendientes", "url": "https://news.google.?oc=5", "medios": ["Cubita NOW", "facebook.com", "La Razón"], "coberturas": [{"medio": "Cubita NOW", "url": "https://news.google.?oc=5", "fecha": "2026-08-06T22:39:39+00:00", "titulo": "EE.UU. contratará empresas para localizar en otros países a migrantes con multas pendientes"}, {"medio": "facebook.com", "url": "https://news.google.?oc=5", "fecha": "2026-08-07T08:02:51+00:00", "titulo": "El Gobierno del presidente #DonaldTrump busca contratar a una empresa privada para que busque y localice en países como México, Guatemala y Honduras, entre otros, a personas deportadas o que salieron voluntariamente de #EEUU y que aún tienen m"}, {"medio": "La Razón", "url": "https://news.google.?oc=5", "fecha": "2026-08-06T20:36:12+00:00", "titulo": "EE UU localizará en el extranjero a migrantes deportados para cobrarles multas pendientes"}], "velocidad": 3, "aceleracion": null, "trends": null, "horas": 16.5, "notas": 7, "otras_urls": ["https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5"], "ejes": ["deportaciones", "politica_migratoria"], "region": "Regional", "paises": ["US"], "paises_nombres": ["Estados Unidos", "México", "Guatemala", "Honduras"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 8, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": [], "actores": ["organismos_migratorios", "estado_nacional"], "etapa": "retorno", "tipo": "normativa", "cobertura": 5, "confianza": 0.9, "tiene_fuente_primaria": false, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "deportaciones", "angulo_sugerido": "Examinar los mecanismos transnacionales de coacción económica a personas deportadas", "nota": "Medida extraterritorial de cobro a personas ya deportadas.", "fuentes_texto": [{"medio": "Cubita NOW", "dominio": "noticias.cubitanow.com", "url": "https://noticias.cubitanow.com/eeuu-contratar-empresas-para-localizar-en-otros-pases-a-migrantes-con-multas-pendientes", "texto": "Redacción de CubitaNOW ~ jueves 6 de agosto de 2026\n\nEl Gobierno del presidente Donald Trump prepara una nueva estrategia para recuperar cientos de millones de dólares en multas migratorias impuestas a personas que fueron deportadas o abandonaron voluntariamente Estados Unidos, mediante la contratación de compañías privadas que puedan localizarlas en el extranjero.\n\nSegún informó la agencia EFE , la Oficina de Aduanas y Protección Fronteriza (CBP, por sus siglas en inglés) abrió una convocatoria para contratar una empresa estadounidense con capacidad de encontrar a migrantes con deudas pendientes en México, Guatemala y Honduras, informarles sobre los montos adeudados y gestionar el proceso de pago.\n\nLa compañía seleccionada deberá contar con mecanismos para identificar a los deudores fuera del territorio estadounidense y proporcionar pruebas que confirmen su identidad. Entre los documentos que podría recopilar figuran fotografías de viviendas, facturas de servicios públicos, registros laborales u otros elementos que permitan verificar la ubicación de la persona.\n\nUna vez localizada, la empresa deberá comunicar al migrante el monto de la multa y ofrecer alternativas para resolver la deuda, incluyendo el pago total, acuerdos de pago a plazos u otras opciones autorizadas. El dinero podrá ser entregado por el propio afectado o por un tercero en su nombre.\n\nCBP estima que alrededor de 66.387 inmigrantes que fueron expulsados de Estados Unidos o salieron voluntariamente del país mantienen multas civiles sin pagar. En conjunto, el Departamento de Seguridad Nacional (DHS) calcula que estas obligaciones superan los 423 millones de dólares.\n\nLa administración Trump retomó el cobro de estas sanciones contra inmigrantes acusados de violar disposiciones de la ley migratoria, incluyendo aquellos que no cumplen una orden de deportación.\n\nEstas multas tienen su origen en la Ley de Inmigración y Nacionalidad de 1996, que estableció una penalización diaria de 500 dólares por incumplir una orden de salida. Con los ajustes por inflación, la cifra actual puede alcanzar hasta 998 dólares por día.\n\nHasta ahora, las empresas privadas contratadas por CBP para recuperar estas deudas operaban dentro de Estados Unidos. La agencia mantiene acuerdos con tres compañías encargadas de gestionar multas y otros cargos relacionados con procesos del Servicio de Inmigración y Control de Aduanas (ICE) y la Patrulla Fronteriza.\n\nSin embargo, cuando los deudores se encuentran fuera del país, los intentos de contacto se limitaban principalmente a llamadas telefónicas o comunicaciones escritas, sin que las compañías lograran localizar efectivamente a personas en el extranjero.\n\nCon la nueva contratación, el Gobierno estadounidense busca extender el alcance de estos mecanismos de cobro hacia otros países y establecer una red de localización internacional de migrantes con sanciones pendientes.\n\nCBP indicó que actualmente no cuenta con ninguna empresa de cobranza que opere directamente fuera de Estados Unidos, por lo que esta iniciativa representaría un cambio en la forma en que el Gobierno intenta recuperar las multas migratorias acumuladas.\n\nCubitaNOW es un espacio dedicado a todos los cubanos con el fin de la unión a través del debate con respeto, el entretenimiento y la nostalgia en momentos difíciles para el pueblo de Cuba. Nuestra misión es informar y entretener a cada cubano alrededor del mundo.", "ok": true}, {"medio": "facebook.com", "dominio": "facebook.com", "url": "https://www.facebook.com/login/?next=https%3A%2F%2Fwww.facebook.com%2FDIARIODECUBA%2Fposts%2Fel-gobierno-del-presidente-donaldtrump-busca-contratar-a-una-empresa-privada-par%2F1616713986477313%2F", "texto": "", "ok": false}, {"medio": "La Razón", "dominio": "larazon.es", "url": "https://www.larazon.es/internacional/localizara-extranjero-migrantes-deportados-cobrarles-multas-pendientes_202608066a74f03ca5690f04736b4c28.html", "texto": "��\u000f\u0000������ ���%@,Unfj\u0016 � �aQ\u0015\u0019�� PY�\u0001�\u0011�է\u0000qU1s�RS�TQ�% �v(�ש\u000e��m��)�:�{�v@��H$\u001a�D`Nk%\u0012\u0017\u0017W���-��C3\u0019� \u0006�\"_�W?�}�}���\u00126i��W��N���6#� D�x�f�_�&��(K߇b���\u0007��3�Ų[\u0000����\u0015��� ��]_m\b���@ ��@m��$�\u0018m\u0006ڻD.��&� ���p��b�7� ��b�7�ʲ�ٴS�\u001a/�Kթ��YOu=/벩.T=�&M5��fӲ���Y��Q��(�����>�g��U�d�z���g�^��7��\u00039 �O\u0011�+E\u000f\b\u0003�\u0011]\"\u0001C�Ǆ� \u0004�\bگ#FK\u0002�h\u0013 \u0004r��%��2�)H�P��0�Ԃ�w}\u0003%C�#���Y ^��p��\u0011֣h���\"a\u0004���ooQ��)�R\u0010(�w8 �;Q����@�2E�`���\u0012FƁ\\\"0d!��?�\u0014��Oܱ\u0006�\u001b\u0019��FMX\u000fГ\u0018\u0006\u000f#�\u0005@A�z��e�\u0007D�m��y�\u001am\u0006�H]\u001b8���vE܈ �Dѡf�ЖW�Z��.[�o��\\:�υ���K�K\u0017�Ԫn�\\5�x\u0003\u0015I\u0005���=�C�������~LaLO�@-\u000e\u0001pĉ�E��I�D�����\u0004:o��M`�}�\u0003���H[���b�i2� �8\u0004J��Z��-\u001b�Үy�Ay`�rw[\u0018LT��H�`!�.W�\\5Ou�8o\u0016U���\u0017JY|-5췵\u0010�\u000f\u0014ӡͪUS^ �p�d^\u0012\u000f��� Ƶe�( |����/p�\\=��}]�󗇻��� ��\u0012d���(r������\u0010� � \u0018\u0002��Gr �)���F�1��oC͋�(\b�,:�\u0013�\u0015���\b>\u0013n9��B,\u0014�\u0000��H���[��\u0003�������`t� ��]��\u0012�\u0015xo\u0001�Q\u0000��#\u001b4$@���ѱ!'$�A\u0007�\u001296��]�ρ����#\u000f�.#\u0010v`� �\"�3AL�)����O 5���0��q齵\b= �&��0\u0011'0��L�\u0001�H�h1�E�\u0006\"L�\u0004��\u0010I̅K\u0004wD\u0011%\u0003Oq \