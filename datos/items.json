: [], "colectividades": ["AR"], "actores": ["estado_nacional", "consulados"], "etapa": "origen", "tipo": "discurso", "cobertura": 4, "confianza": 0.8, "tiene_fuente_primaria": false, "contiene_datos_personales": false, "requiere_verificacion": true, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "visas", "angulo_sugerido": "Verificar fuentes oficiales diplomáticas sobre modificaciones en el régimen de visados.", "nota": "Especulación sobre posible eliminación de visado, con bajo impacto operativo actual."}, {"id": "ea6a5f06f077", "titulo_original": "Los 300 surcoreanos detenidos por el ICE en una fábrica de Hyundai denuncian a la Administración Trump", "url": "https://news.google.com/rss/articles/CBMi-?oc=5", "medios": ["El Diario NY", "EL PAÍS", "lanacion.com.ar"], "coberturas": [{"medio": "El Diario NY", "url": "https://news.google.com/rss/articles/CBMiugFBVV95cUxPMlU2ZWMwRlMxaHQtQlJxYnhaS3NNdWlnUFYwUjdjQ1B2UDZRQXdYT19QeWdoaXp0TE1sZmJpY3VjNkp3ZmNMU09zSGNCQk9ZSkp1YmpJdFdNSXVXWHRjd0ZkczB2bEZFd2F2ckpzemk3MnAxYy1jS1NrVnRDQlh5ZGJEUWUxcUZjejNrb0ZyUzF2OWpfbmFZVWtuWVRXX0ZLa3pTR3FQTi1feE8wZ1ozUHZkRVJ3alB1ekE?oc=5", "fecha": "2026-09-16T18:44:31+00:00", "titulo": "Surcoreanos detenidos en planta de Hyundai y LG preparan demanda contra ICE y Trump"}, {"medio": "EL PAÍS", "url": "https://news.google.?oc=5", "fecha": "2026-09-16T19:19:46+00:00", "titulo": "Los 300 surcoreanos detenidos por el ICE en una fábrica de Hyundai denuncian a la Administración Trump"}, {"medio": "lanacion.com.ar", "url": "https://news.google.com/rss/articles/CBMi-?oc=5", "fecha": "2026-09-16T16:47:00+00:00", "titulo": "Para frenar al ICE: el operativo con 300 migrantes detenidos en una fábrica que derivó en un reclamo millonario"}], "velocidad": 3, "aceleracion": null, "trends": null, "horas": 18.3, "notas": 4, "otras_urls": ["https://news.google.com/rss/articles/CBMi-?oc=5", "https://news.google.?oc=5", "https://news.google.com/rss/articles/CBMiugFBVV95cUxPMlU2ZWMwRlMxaHQtQlJxYnhaS3NNdWlnUFYwUjdjQ1B2UDZRQXdYT19QeWdoaXp0TE1sZmJpY3VjNkp3ZmNMU09zSGNCQk9ZSkp1YmpJdFdNSXVXWHRjd0ZkczB2bEZFd2F2ckpzemk3MnAxYy1jS1NrVnRDQlh5ZGJEUWUxcUZjejNrb0ZyUzF2OWpfbmFZVWtuWVRXX0ZLa3pTR3FQTi1feE8wZ1ozUHZkRVJ3alB1ekE?oc=5"], "ejes": ["deportaciones", "derechos_humanos", "trabajo"], "region": "Norteamérica", "paises": ["US"], "paises_nombres": ["Estados Unidos"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 9, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": [], "actores": ["organismos_migratorios", "empresas", "sociedad_civil"], "etapa": "destino", "tipo": "caso", "cobertura": 5, "confianza": 0.95, "tiene_fuente_primaria": false, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "deportaciones", "angulo_sugerido": "Analizar las acciones legales presentadas por los trabajadores afectados contra la administración.", "nota": "Detención masiva en centro de trabajo y posterior demanda judicial contra autoridades migratorias.", "fuentes_texto": [{"medio": "EL PAÍS", "dominio": "elpais.com", "url": "https://elpais.com/us/migracion/2026-09-16/los-300-surcoreanos-detenidos-por-el-ice-en-una-fabrica-de-hyundai-denuncian-a-la-administracion-trump.html", "texto": "Los trabajadores dicen que sufrieron abusos de los agentes en la mayor redada de la agencia, que puso en peligro las relaciones de Estados Unidos con Corea del Sur\n\nMás de 300 trabajadores surcoreanos, detenidos durante la redada migratoria del año pasado en una planta de Hyundai en Georgia, están emprendiendo acciones legales contra el Gobierno de Estados Unidos, según una información de la CNN que cita a una abogada que representa a los afectados.\n\nCuando se cumple un año de la operación, los afectados han comenzado a presentar reclamaciones administrativas —un paso obligatorio previo a una demanda federal— ante nueve agencias federales, entre ellas el Departamento de Seguridad Nacional (DHS), el Servicio de Inmigración y Control de Aduanas (ICE), la Oficina de Aduanas y Protección Fronteriza (CBP), el FBI y los Departamentos de Justicia y Trabajo. Se espera que todas las reclamaciones se hayan presentado antes de final de año.\n\nLa operación del ICE en la planta de fabricación de baterías eléctricas en la ciudad de Ellabell el 4 de septiembre de 2025 fue la mayor redada que habían realizado las autoridades migratorias en Estados Unidos en un solo lugar —según declaró el responsable de Investigaciones de Seguridad Nacional en Atlanta, Steven Schrank—, y amenazó con crear un conflicto diplomático con Corea del Sur, un importante socio comercial.\n\nUnos 500 agentes federales, estatales y locales irrumpieron en las instalaciones y detuvieron a 475 trabajadores, de los que 300 eran surcoreanos. El resto de los detenidos eran en su mayoría hispanos. Muchos de ellos tenían papeles en regla, pero los agentes los esposaron y detuvieron. Les obligaron a firmar documentos que no entendían, según declararon, y les encerraron en centros de detención del ICE.\n\nVideos y fotografías del incidente mostraron a los trabajadores encadenados de las muñecas, la cintura y los tobillos. Se confiscaron los teléfonos de los trabajadores y algunos no pudieron avisar a sus familias en sus países de origen hasta que días después fueron liberados.\n\n“Incluso después de que nos detuvieran no sabíamos por qué nos habían llevado ni qué delito habíamos cometido. Nadie sabía nada. Todos estábamos simplemente desconcertados”, dijo un trabajador a CNN. “Si al menos nos hubieran explicado las cosas mientras procedían, tal vez lo hubiera entendido un poco”, agregó.\n\nEl Gobierno surcoreano transmitió entonces su “preocupación y pesar” a Washington, envió diplomáticos a Georgia y advirtió que no deben violarse los derechos de los ciudadanos coreanos que invierten en proyectos estadounidenses.\n\nEl DHS justificó en su día que algunos habían entrado ilegalmente, otros habían excedido la vigencia de sus visas y otros contaban con exenciones de visa que les prohibían trabajar. Los dos gobiernos mantuvieron negociaciones y acordaron la liberación de los detenidos surcoreanos y el envío de un vuelo chárter para ser repatriados. Varios de ellos regresaron meses después a sus trabajos en la fábrica.\n\nEn la primera denuncia presentada, el demandante alega que fue detenido ilegalmente y “sometido a condiciones de vida degradantes” mientras permaneció en un centro del ICE durante siete días, y agrega que la redada resultó en “la imposición intencional de angustia emocional, humillación… y un trauma psicológico duradero”.\n\nAl cumplirse un año de la macrorredada, uno de los trabajadores hispanos, el colombiano Alfredo Fajardo Melgarejo ha presentado una reclamación administrativa para pedir una compensación económica por la conducta violenta e ilegal de los agentes del ICE en la redada. Fajardo alega que los agentes utilizaron fuerza excesiva y tácticas de corte militar para detenerlo sin causa, aterrorizándolo durante el proceso. Afirma que agentes armados del ICE derribaron a patadas la puerta de su lugar de trabajo mientras le gritaban en inglés, un idioma que él apenas comprende. Lo estrangularon, lo forcejearon violentamente y lo humillaron apuntándole con un arma antes de ar", "ok": true}, {"medio": "El Diario NY", "dominio": "eldiariony.com", "url": "https://eldiariony.com/2026/09/16/surcoreanos-detenidos-en-planta-de-hyundai-y-lg-preparan-demanda-contra-ice-y-trump/", "texto": "U��Rd`�8\u0000\u0000��\u000f!��\u000fs�\u0000�I�\u0007@�\"!�� ����� ��\u0000\u0010��j�;�.������|���r�[�O��H�\u0001\u0012\u0000?\")��v���\\��K;��v?\u0015D Qp�\u0004/\u0000�cE�Z�nj?��w�\u0018ӟ�� @ nl\u0017]?\u0003!NB?h�&A����*�ϞM�@x!S�#i�\u0017?�7x=W�ڍ ��A\u001arhw�GF8cq\\1���M~��r�+�C\u0004\u0016J�\u001a��\u000e�e\u0018��ǰ�ư�e\u0004I�W+�`�����7 \u0014B�\u0018��5֡���şNc���\u0013�� ����A���[�}@0�C�pU�a�\u000e *�$Pxk�� t�ǿ9��?�kR/;\\E