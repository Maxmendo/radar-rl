FxZVY4V1NxTW9MYk90QkZfRk9GYzY2eGZBb2hUSzEtREVQVGhYWmxSR29zbXFFNUZBTy1jMGU?oc=5"], "ejes": ["rutas"], "region": "Regional", "paises": ["BO", "CO", "CR"], "paises_nombres": ["Bolivia", "Colombia", "Costa Rica"], "pais_inferido": true, "fuera_de_alcance": true, "importancia": null, "clasificado": false}, {"id": "b14fca6d30e0", "titulo_original": "Beneficiarios del TPS pierden protección que mantenía vigentes sus permisos de trabajo tras fallo de juez", "url": "https://news.google.?oc=5", "medios": ["diario.elmundo.sv", "La Prensa Gráfica", "laprensagrafica.com"], "coberturas": [{"medio": "diario.elmundo.sv", "url": "https://news.google.?oc=5", "fecha": "2026-08-06T16:13:14+00:00", "titulo": "Tribunal de EE.UU. permite la terminación de los permisos de trabajo de los salvadoreños con TPS"}, {"medio": "La Prensa Gráfica", "url": "https://news.google.?oc=5", "fecha": "2026-08-06T15:15:00+00:00", "titulo": "Beneficiarios del TPS pierden protección que mantenía vigentes sus permisos de trabajo tras fallo de juez"}, {"medio": "laprensagrafica.com", "url": "https://news.google.?oc=5", "fecha": "2026-08-06T15:15:00+00:00", "titulo": "Beneficiarios del TPS pierden protección que mantenía vigentes sus permisos de trabajo tras fallo de juez"}], "velocidad": 3, "aceleracion": null, "trends": null, "horas": 23.1, "notas": 4, "otras_urls": ["https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5"], "ejes": ["estatus", "justicia", "trabajo"], "region": "Centroamérica", "paises": ["US"], "paises_nombres": ["El Salvador"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 9, "clasificado": true, "es_migratorio": true, "poblaciones": ["familias"], "colectividades": [], "actores": ["poder_judicial"], "etapa": "destino", "tipo": "normativa", "cobertura": 5, "confianza": 0.95, "tiene_fuente_primaria": true, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "estatus migratorio", "angulo_sugerido": "Cuántos trabajadores pierden sus permisos de trabajo de forma inmediata", "nota": "Fallo judicial que erosiona derechos laborales y estatus protegido.", "fuentes_texto": [{"medio": "La Prensa Gráfica", "dominio": "laprensagrafica.com", "url": "https://www.laprensagrafica.com/departamento15/beneficiarios-del-tps-pierden-proteccion-que-mantenia-vigentes-sus-permisos-de-trabajo-tras-fallo-de-juez-20260806-0023.html", "texto": "", "ok": false}, {"medio": "diario.elmundo.sv", "dominio": "diario.elmundo.sv", "url": "https://diario.elmundo.sv/ampArticle/tribunal-de-ee-uu-permite-la-terminacion-de-los-permisos-de-trabajo-de-los-salvadorenos-con-tps?amp=1", "texto": "Un tribunal federal de distrito en Massachusetts denegó el miércoles una petición demandante que impugnaba la terminación adelantada de las autorizaciones de empleo del programa de Estatus de Protección Temporal (TPS) para El Salvador, Ucrania y Sudán .\n\nEn la resolución, el juez argumentó que es «poco probable» que los demandantes tuvieran éxito en una demanda que impugna la restricción de las autorizaciones de empleo\n\nDe acuerdo con la firma especializada en migración Fragomen, el gobierno estadounidense puede proceder con su terminación planificada de la autorización de empleo de salvadoreños, ugandeses y sudaneses, prevista para el 22 de julio y que había sido pospuesta por el tribunal hasta ayer, mientras resolvía la demanda.\n\n«Por las razones expuestas, se accede a la moción de los demandantes de suspender la actuación de la agencia en virtud del artículo 705 del título 5 del Código de los Estados Unidos en lo que respecta a la aplicación de consecuencias por la falta de pago de la tarifa anual de asilo. El Tribunal suspende la implementación de dicha política hasta que emita un fallo definitivo sobre el fondo del asunto. Con respecto a las demás políticas impugnadas, se deniega la moción», indica la resolución emitida ayer.\n\nEl tribunal indicó que los demandantes no demostraron tener probabilidades de éxito al probar que la «Política de Tope», que acorta la duración de los permisos de trabajo, es ilegal; o que «su aplicación a las prórrogas de EAD emitidas anteriormente tiene un carácter retroactivo inadmisible».\n\nLa resolución hace un recuento sobre el caso e indica que, el 4 de julio de 2025, se promulgó la Ley «One Big Beautiful Bill», la cual modificó vigencias de los documentos de autorización de empleo (EAD, por sus siglas en inglés) asociados al TPS y a las solicitudes de asilo.\n\nEn la demanda, los solicitantes impugnan el límite de un año para la emisión o renovación de los permisos de trabajo, conocida como «Política de Tope» o «Política del Límite»; también impugnan la aplicación de la Política de Límite a las prórrogas de los EAD informada en el sitio web de la USCIS; e impugnan normas sobre las solicitudes de asilo relacionadas al cobro a los solicitantes de asilo.\n\nLa resolución no afecta la fecha de vigencia del TPS para El Salvador prorrogada el 17 de enero de 2025, también para Ucrania y Sudán, por un periodo de 18 meses.", "ok": true}, {"medio": "laprensagrafica.com", "dominio": "laprensagrafica.com", "url": "https://www.laprensagrafica.com/departamento15/beneficiarios-del-tps-pierden-proteccion-que-mantenia-vigentes-sus-permisos-de-trabajo-tras-fallo-de-juez-20260806-0023.html", "texto": "", "ok": false}]}, {"id": "c54c3afb19aa", "titulo_original": "Estados Unidos quiere cobrarles multas a migrantes deportados en sus países de residencia", "url": "https://news.google.?oc=5", "medios": ["La Bandera", "Primicias"], "coberturas": [{"medio": "La Bandera", "url": "https://news.google.?oc=5", "fecha": "2026-08-07T13:34:58+00:00", "titulo": "Trump buscará cobrar más de 300 millones de dólares en multas a inmigrantes ilegales que salieron de Estados Unidos"}, {"medio": "Primicias", "url": "https://news.google.com/rss/articles/CBMingFBVV95cUxQQ2k2SWwxWXZ2QURoS2tHRlo3RS1RQ21IN0hsc3hLbWtBejVQdU4y