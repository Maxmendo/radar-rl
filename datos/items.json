{"generado": "2026-08-11T19:02:13+00:00", "clasificado": true, "notas_totales": 223, "items": [{"id": "8bbfd5153a3e", "titulo_original": "Argentina inicia el cobro de la atención sanitaria a extranjeros no residentes", "url": "https://news.google.?oc=5", "medios": ["andigital.com.ar", "crhoy.com", "Diario de Cuyo", "Diario El Debate Pregón", "EconoBlog", "El Canciller", "ElDoce.tv", "eluniverso.com", "facebook.com", "Haceinstantes", "Infobae", "Infogate.cl", "InfoVeloz.com", "La Nación", "La Noticia 1", "LaRepublica.co", "Nexofin", "noticias.cubitanow.com", "Resumen Latinoamericano -", "Tendencia de Noticias", "ultimahora.com", "upsanfrancisco.com.ar", "ushuaia24.com.ar"], "coberturas": [{"medio": "andigital.com.ar", "url": "https://news.google.com/rss/articles/CBMivAFBVV95cUxNcktJNFN5VXkwQWpSX2NnbVNRUERmaHd1U0FxU1BqZENSLUlFN2ZCcFVuTWgxSVlDVU00QVAwaXpCVUdQZkd5dHpFTE5LQ1ZEUXp4WklVRG40Qkg3aW9DSjZZNVZFYTdQRWNVRkx1UjlWbzN0MVpicVM4N2t4bGREQkNxY0hoX2VLLWhnUDFvbmxZdFpjOXBQeXlWOVlHR2NIX1A2enJsVE1wbWJkemZra2h5NndEb19FNC02LQ?oc=5", "fecha": "2026-08-11T12:00:50+00:00", "titulo": "Los extranjeros no residentes deberán pagar por atenderse en hospitales nacionales"}, {"medio": "crhoy.com", "url": "https://news.google.com/rss/articles/CBMilAFBVV95cUxPVncxb2JGLWVMNGkxUU1OU2RYYURUNGhBaUhKN3FwSnJCSi1ael9SbTU2eUp2eXBZZVQ5R0t0M1p0VUNXb0NCYlg1MUZxUGpQajRFYWoxN1o2d3ZwSEJGal94VklwV1VHM2xrQk1ORUF4TWtUMXQ5UUpZd0xVOGQ0TmU3Vm1WLUpSYk10Y2ktZGZQYzZR?oc=5", "fecha": "2026-08-11T18:14:00+00:00", "titulo": "Argentina cobrará atención médica a extranjeros no residentes"}, {"medio": "Diario de Cuyo", "url": "https://news.google.?oc=5", "fecha": "2026-08-11T11:11:00+00:00", "titulo": "Extranjeros no residentes deberán pagar la atención en hospitales nacionales: qué cambia y cuándo se aplicará"}, {"medio": "Diario El Debate Pregón", "url": "https://news.google.?oc=5", "fecha": "2026-08-11T12:15:00+00:00", "titulo": "Extranjeros no residentes deberán tener seguro de salud o pagar la atención en hospitales nacionales"}, {"medio": "EconoBlog", "url": "https://news.google.com/rss/articles/CBMimAFBVV95cUxOY0FjQ1U0QmpNeWtiSTg1bEoxajV0XzNTUVRaQ05VVXlzNG11dm1xQTNwUFhRR3Z4MzZvZHVLd25iOWYwTFV6cVVNMWVKZVEtbmFrdHhwWGNEYk10VWd4eUttc1RlMDBGdkFjZnBBQXJJV29yZVEyNTEwV2VxaTFTSXBHUWRraHVVQl9paTdGMVV1UTBFbzhacg?oc=5", "fecha": "2026-08-11T13:26:00+00:00", "titulo": "Argentina empieza a cobrar atención médica a extranjeros"}, {"medio": "El Canciller", "url": "https://news.google.?oc=5", "fecha": "2026-08-11T10:55:59+00:00", "titulo": "Reglamentaron el pago de extranjeros no residentes por la atención en hospitales nacionales: los detalles de la medida"}, {"medio": "ElDoce.tv", "url": "https://news.google.?oc=5", "fecha": "2026-08-11T11:44:23+00:00", "titulo": "Extranjeros no residentes deberán pagar por la salud en los hospitales nacionales: las excepciones"}, {"medio": "eluniverso.com", "url": "https://news.google.?oc=5", "fecha": "2026-08-11T18:40:00+00:00", "titulo": "Argentina comenzará a cobrar a extranjeros no residentes por atención médica no urgente"}, {"medio": "facebook.com", "url": "https://news.google.?oc=5", "fecha": "2026-08-11T18:12:18+00:00", "titulo": "Argentina dio por terminada la salud gratis para extranjeros. La presidencia argentina informó que todo paciente extranjero que no sea residente permanente deberá contar con seguro médico. https://tinyurl.com/y3dnb352 #EUVzla #ElUniversal"}, {"medio": "Haceinstantes", "url": "https://news.google.com/rss/articles/CBMi_?oc=5", "fecha": "2026-08-11T14:46:47+00:00", "titulo": "Cambios en el acceso a la salud pública: extranjeros sin residencia en el país deberán pagar por la atención"}, {"medio": "Infobae", "url": "https://news.google.?oc=5", "fecha": "2026-08-11T14:34:04+00:00", "titulo": "Argentina inicia el cobro de la atención sanitaria a extranjeros no residentes"}, {"medio": "Infogate.cl", "url": "https://news.google.com/rss/articles/CBMiygFBVV95cUxQaFI0TWluMEt2RzlDdXF0MUtkbUwxQ20wcnplNzJqNkVoaWowV0pHRGR0NTZuMEM1Zz