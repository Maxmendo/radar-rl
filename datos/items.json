medio": "El Buen Tono", "url": "https://news.google.com/rss/articles/CBMisAFBVV95cUxOcXRaSklPZC1QSmhuYUlKQWFaX1RiV2Z1R2dhaGNkVkhGUmVxR0JHTGRzN0sxT1owSVBDTkNoOWNVSW9tUk5Vazk0U0xiTkd1MkZ6U2dZVW5JcnhYVGpsS2FsTHRRbFA4SnlpZmJHMEVfdFNkelYwbGRWYjVtaTFZM0hkUUJTYW5xTlVnTFdrM0x3QlZaazlocWtFdDJGb3BYaHNYNW5zekIwQmE3cXMwUw?oc=5", "fecha": "2026-09-26T22:40:46+00:00", "titulo": "Amnistía Internacional pide abolir el ICE tras denunciar abusos contra migrantes"}, {"medio": "eltiempomx.com", "url": "https://news.google.?oc=5", "fecha": "2026-09-27T02:37:30+00:00", "titulo": "Amnistía documenta abusos del ICE contra migrantes en Estados Unidos"}, {"medio": "Zona Franca", "url": "https://news.google.com/rss/articles/CBMimAFBVV95cUxQeTNvcUxucXIyYTZKX3A0aVA5T1otWXktV01UVk1pR2tDTWZFTXRyYmh6eUxydUdieFRyYkFiNGwydm4yYWZESlN1OGg1UldRLXFtNUZDZmJGWlVLZlREUGpVYnpoRU1uTnJKNlVVUGZuci1nVUVsZzZNU3VWd05CbWNMTEFoTmJzUjRSRm13RG9mU1AyWmp6Zw?oc=5", "fecha": "2026-09-26T23:21:52+00:00", "titulo": "Redadas en EU golpean a mexicanos; Amnistía documenta"}], "velocidad": 3, "aceleracion": null, "trends": null, "horas": 17.8, "notas": 3, "otras_urls": ["https://news.google.?oc=5", "https://news.google.com/rss/articles/CBMimAFBVV95cUxQeTNvcUxucXIyYTZKX3A0aVA5T1otWXktV01UVk1pR2tDTWZFTXRyYmh6eUxydUdieFRyYkFiNGwydm4yYWZESlN1OGg1UldRLXFtNUZDZmJGWlVLZlREUGpVYnpoRU1uTnJKNlVVUGZuci1nVUVsZzZNU3VWd05CbWNMTEFoTmJzUjRSRm13RG9mU1AyWmp6Zw?oc=5"], "ejes": ["deportaciones", "derechos_humanos"], "region": "Norteamérica", "paises": ["US", "MX"], "paises_nombres": ["Estados Unidos"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 8, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": ["MX"], "actores": ["sociedad_civil", "organismos_migratorios"], "etapa": "destino", "tipo": "dato", "cobertura": 3, "confianza": 0.9, "tiene_fuente_primaria": true, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "deportaciones", "angulo_sugerido": "Analizar el informe de Amnistía sobre el impacto de las redadas en comunidades mexicanas", "nota": "Documentación de violaciones de derechos en operativos de deportación.", "fuentes_texto": [{"medio": "El Buen Tono", "dominio": "elbuentono.com.mx", "url": "https://www.elbuentono.com.mx/amnistia-internacional-pide-abolir-el-ice-tras-denunciar-abusos-contra-migrantes/", "texto": "Amnistía Internacional (AI) exigió la abolición del Servicio de Inmigración y Control de Aduanas de Estados Unidos (ICE), luego de documentar presuntas violaciones de derechos humanos durante operativos migratorios realizados en Chicago, Minneapolis-St. Paul, Nueva Orleans y Washington D. C.\n\nEn un informe publicado el 24 de septiembre de 2026, la organización denunció presuntas detenciones arbitrarias, uso injustificado de la fuerza, hostigamiento, intimidación y posibles desapariciones forzadas, además de otras conductas que, según el documento, afectarían a personas migrantes, solicitantes de asilo y refugiadas.\n\nLa investigación señala que las actuaciones del ICE, la Oficina de Aduanas y Protección Fronteriza (CBP) y otras agencias federales formarían parte de un patrón de vulneraciones a los derechos humanos, por lo que AI considera necesario modificar de manera estructural el sistema de control migratorio estadounidense.\n\nEl organismo también documentó denuncias sobre operativos que habrían utilizado perfiles raciales, agentes con el rostro cubierto y sin identificación visible, así como armas de letalidad reducida, entre ellas gases lacrimógenos y aerosoles de gas pimienta, durante protestas.\n\nDe acuerdo con Amnistía Internacional, también se registraron casos relacionados con condiciones de reclusión que podrían constituir malos tratos, además de situaciones de incomunicación y posibles desapariciones forzadas.\n\nLa investigación incluyó entrevistas con 154 personas y se concentró en las cuatro ciudades y zonas metropolitanas señaladas. Según AI, los efectos de los operativos también alcanzaron a comunidades negras y de piel oscura.\n\nNadia Daar, directora ejecutiva de Amnistía Internacional Estados Unidos, sostuvo que los casos documentados representan un patrón de violaciones de derechos humanos y señaló que las prácticas denunciadas generan temor entre comunidades migrantes, solicitantes de asilo y refugiadas.\n\nLa organización también cuestionó la falta de investigaciones y mecanismos de rendición de cuentas que, desde su perspectiva, permitan esclarecer de manera efectiva las denuncias contra agentes federales.\n\nComo parte de sus planteamientos, Amnistía Internacional propone la disolución del ICE y la creación de un sistema de control migratorio que cumpla con las obligaciones internacionales en materia de derechos humanos.\n\nAna Piquer, directora para las Américas de la organización, señaló que prácticas como las detenciones arbitrarias, la separación de familias y los perfiles raciales pueden generar consecuencias que se extienden a familiares y comunidades.\n\nAI pidió además que se investiguen las denuncias y que se establezcan mecanismos para exigir responsabilidades a los funcionarios involucrados, con el objetivo de garantizar el respeto a la dignidad y los derechos de las personas durante los procedimientos migratorios.", "ok": true}, {"medio": "Zona Franca", "dominio": "zonafranca.mx", "url": "https://zonafranca.mx/politica-sociedad/redadas-en-eu-golpean-a-mexicanos-amnistia-documenta/", "texto": "", "ok": false}]}, {"id": "1e2dad559c89", "titulo_original": "Gobierno de Trump elimina casi US$1.000 millones para programas de inmigrantes y diversidad", "url": "https://news.google.?oc=5", "medios": ["Análisis Urbano", "Diario Libero", "libero.pe"], "coberturas": [{"medio": "Análisis Urbano", "url": "https://news.google.com/rss/articles/CBMingFBVV95cUxOS0JuZVFuVS0xdTR5T2t1czBFdU16WmdBQUpKQUEtemlDRU4zemV3T0VuN2NuazlNS0RUVDhwV3ptemthNGJTZjYtZVNvSVVmTHNCNFViT2hsMHBFX2piOEQxb0RxSG4xcWlkVU5QNzBQbHo3QWE3b2dvZnNTczdrTnVvMmlLQkhuYzBxOEFoOHVObnExYTQ3eVByc29vdw?oc=5", "fecha": "2026-09-26T19:40:07+00:00", "titulo": "Gobierno de Trump elimina casi US$1.000 millones para programas de inmigrantes y diversidad"}, {"medio": "Diario Libero", "url": "https://news.google.?oc=5", "fecha": "2026-09-27T04:00:35+00:00", "titulo": "ALERTA MÁXIMA, inmigrantes legales e indocumentados en EE. UU.: Alcaldesa de ESTA CIUDAD en Florida dice que firmó acuerdo con ICE bajo amenaza de Ron DeSantis"}, {"medio": "libero.pe", "url": "https://news.google.?oc=5", "fecha": "2026-09-27T04:00:35+00:00", "titulo": "ALERTA MÁXIMA, inmigrantes legales e indocumentados en EE. UU.: Alcaldesa de ESTA CIUDAD en Florida dice que firmó acuerdo con ICE bajo amenaza de Ron DeSantis"}], "velocidad": 3, "aceleracion": null, "trends": null, "horas": 20.8, "notas": 11, "otras_urls": ["https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5"], "ejes": ["politica_migratoria", "acceso_derechos"], "region": "Norteamérica", "paises": ["US"], "paises_nombres": ["Estados Unidos"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 9, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": [], "actores": ["estado_nacional"], "etapa": "destino", "tipo": "normativa", "cobertura": 3, "confianza": 0.95, "tiene_fuente_primaria": true, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "inmigrantes", "angulo_sugerido": "Detallar qué programas específicos pierden financiamiento", "nota": "Medida gubernamental que afecta la integración y derechos de migrantes.", "fuentes_texto": [{"medio": "Análisis Urbano", "dominio": "analisisurbano.org", "url": "https://analisisurbano.org/trump-cancela-fondos-inmigrantes-refugiados-diversidad-estados-unidos/", "texto": "", "ok": false}, {"medio": "Diario Libero", "dominio": "libero.pe", "url": "https://libero.pe/estados-unidos/2026/09/24/alerta-maxima-inmigrantes-legales-indocumentados-en-estados-unidos-alcaldesa-de-ciudad-en-florida-dice-firmo-acuerdo-ice-amenaza-de-ron-desantis-ee-uu-usa-lbeu-1504824", "texto": "0 Últimas noticias Fútbol Peruano F. Internacional Deportes Ocio ESTADOS UNIDOS VIDEOS TEC LÍBERO Tiempo Extra EN VIVO Sporting Cristal vs ADT por Copa de la Liga Estados Unidos Inmigrantes ALERTA MÁXIMA, inmigrantes legales e indocumentados en EE. UU.: Alcaldesa de ESTA CIUDAD en Florida dice que firmó acuerdo con ICE bajo amenaza de Ron DeSantis Frente a la presión por los operativos migratorios en Florida y al riesgo de perder su cargo ante DeSantis , Fraga optó por alcanzar un acuerdo con el ICE.\n\nMaría Zapata Actualizado el 27 Sep. 2026 | 08:00 H La alcaldesa de Doral dijo que firmó el acuerdo con ICE bajo presión del gobernador DeSantis | Composición: María Zapata | Líbero COMPARTIR Siguenos en Google News Las recientes medidas migratorias impulsadas por el Gobierno de Estados Unidos han generado mayor preocupación entre las comunidades de inmigrantes, especialmente ante la continuidad de los operativos de las autoridades federales. En este contexto, la alcaldesa de Doral, Florida , se refirió a las intervenciones realizadas en la ciudad y señaló que estas no estarían dirigidas exclusivamente a un grupo de residentes. Durante una entrevista con Telemundo 51 Miami , la funcionaria abordó las dudas de la comunidad y sostuvo que los operativos han alcanzado tanto a personas con estatus migratorio regular como a quienes permanecen en el país sin la documentación requerida.\n\nPUEDES VER: ALERTA MÁXIMA, inmigrantes legales e indocumentados en EE. UU.: ICE prepara &quot;instalaciones móviles&quot; para detenciones, ¿en qué consiste este NUEVO MÉTODO?\n\nFrente a la creciente alarma entre los miembros de la comunidad hispana, la alcaldesa de Doral, Christi Fraga, salió al paso para aclarar la postura y el nivel de involucramiento del departamento de policía local con el Servicio de Inmigración y Control de Aduanas (ICE). En una entrevista concedida al espacio Encuentro Virtual de Telemundo 51 Miami , la funcionaria enfatizó tajantemente: &quot;Nuestra policía no ha colaborado con ICE en ninguna redada&quot;.\n\nFraga buscó llevar tranquilidad a las familias trabajadoras al asegurar que los efectivos municipales no recibieron capacitaciones específicas ni ejecutaron arrestos coordinados con los agentes federales . En sus declaraciones para Telemundo 51 Miami , dirigió un mensaje directo a la población inmigrante de la zona: &quot;No deben tener ningún miedo de nuestro departamento de policía&quot; . Asimismo, detalló que las agencias federales operan de forma independiente, sin avisar previa ni posteriormente a la administración municipal sobre sus intervenciones en el área.\n\nAl ser cuestionada directamente por la periodista Gloria Ordaz sobre los motivos que la llevaron a suscribir la alianza con las autoridades migratorias, la líder local denunció haber actuado bajo la coerción de las más altas autoridades del estado de Florida . La alcaldesa de Doral sostuvo que acató la normativa por temor a severas represalias institucionales , señalando explícitamente al gobernador Ron DeSantis y al fiscal general de la entidad. Fraga explicó que se les advirtió a los funcionarios electos que podrían ser destituidos de sus cargos y que las fuerzas del orden locales arriesgaban la pérdida de sus acreditaciones oficiales si rechazaban el acuerdo 287(g).\n\nAnte las insistentes peticiones de renuncia por parte de activistas comunitarios y la exigencia de romper el pacto con la agencia federal, la regidora prefirió no tomar una postura definitiva de inmediato. Manifestó que envió una consulta formal al fiscal general del estado para exigir aclaraciones jurídicas sobre por qué otras jurisdicciones no firmaron el documento sin recibir castigos. La alcaldesa reiteró que ha expuesto estas inquietudes directamente en la Casa Blanca y ante el presidente Donald Trump, visibilizando la dura realidad de la comunidad venezolana local. Por ahora, la permanencia de Doral, Florida, en este esquema normativo permanece bajo evaluación a la espera de un dictamen ofic", "ok": true}]}, {"id": "01902c205d80", "titulo_original": "Deportación de migrantes a prisiones de Esuatini: protestas por acuerdo secreto entre EE.UU. y el reino", "url": "https://news.google.?oc=5", "medios": ["Pulzo", "pulzo.com"], "coberturas": [{"medio": "Pulzo", "url": "https://news.google.?oc=5", "fecha": "2026-09-27T09:31:17+00:00", "titulo": "Deportación de migrantes a prisiones de Esuatini: protestas por acuerdo secreto entre EE.UU. y el reino"}, {"medio": "pulzo.com", "url": "https://news.google.?oc=5", "fecha": "2026-09-27T09:31:17+00:00", "titulo": "Deportación de migrantes a prisiones de Esuatini: protestas por acuerdo secreto entre EE.UU. y el reino"}], "velocidad": 2, "aceleracion": null, "trends": null, "horas": 7.0, "notas": 2, "otras_urls": ["https://news.google.?oc=5"], "ejes": ["deportaciones", "politica_migratoria"], "region": "Sudamérica", "paises": ["US", "SZ"], "paises_nombres": ["Bolivia", "Colombia", "Ecuador"], "pais_inferido": true, "fuera_de_alcance": false, "importancia": 9, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": [], "actores": ["estado_nacional", "sociedad_civil"], "etapa": "destino", "tipo": "evento", "cobertura": 2, "confianza": 0.9, "tiene_fuente_primaria": false, "contiene_datos_personales": false, "requiere_verificacion": true, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "deportaciones", "angulo_sugerido": "Investigar los términos legales del acuerdo secreto de tercer país seguro", "nota": "Derivación de deportados a terceros países. Alto impacto en derechos."}, {"id": "4e3fa0ceeabb", "titulo_original": "ICE siembra