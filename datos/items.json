{"generado": "2026-09-28T18:02:59+00:00", "clasificado": true, "notas_totales": 276, "items": [{"id": "4279ef08f659", "titulo_original": "NI LA LLUVIA FRENA CARAVANA DE MÁS DE 600 MIGRANTES", "url": "https://news.google.?oc=5", "medios": ["ABC", "Cuba en Miami", "Diario de Chiapas", "Diario Tiempo de Honduras", "El Buen Tono", "El Congresista", "El Heraldo de San Luis Potosí.", "EL INFORMADOR - Santa Marta, Colombia", "Emisoras Unidas", "estrelladigital.com.mx", "jornada.com.mx", "laprensa.hn", "laprensagrafica.com", "López-Dóriga Digital", "Mi Punto de Vista", "MILENIO", "mipuntodevista.com.mx", "Prensa Libre", "prensalibre.com", "Pulso Diario San Luis", "UnoTV", "vanguardia.com.mx", "www.laprensa.hn"], "coberturas": [{"medio": "ABC", "url": "https://news.google.com/rss/articles/CBMingFBVV95cUxPS284ZXZXNkFDTXcwVGd4VExUcTI5akdkQk9EcWVVbl9uNEp6LXI0b2lYdlllOGtFb3ozdDdoY24xb1NCa1pjSDZFZzc1b3JRUzd1MVpVaUhpWVJmTHFyTm50VnhyUUc2Vlc1S3BLVzZwYUlGdDJ2VDQ2bzVlbDBiVlgxd2dYbWtzU3ZpNmdKd0VEeGxFbDJDMmhxVDlOdw?oc=5", "fecha": "2026-09-28T09:17:23+00:00", "titulo": "Caravana con más de 600 migrantes sigue su camino desde el sur de México a EE.UU."}, {"medio": "Cuba en Miami", "url": "https://news.google.?oc=5", "fecha": "2026-09-28T15:00:37+00:00", "titulo": "“La frontera está cerrada”: el mensaje atribuido al DHS mientras una nueva caravana migrante avanza por México"}, {"medio": "Diario de Chiapas", "url": "https://news.google.com/rss/articles/CBMihwFBVV95cUxPQk80WUtyQjJBRlFPSG90TlM4RUZtQW5qSzMybEgyWm9YRUpfWnZvUVhmSUVxMXZ4QXhwdDVLUTY4dUJqcFRHMFF6emlEalRLYnhkUlN0NzdMdW10MWVtbW5XbDdmUHFMck1oRkhuWWtCQ0ExSHVRalV0bGlLS3hzc1RXa0tLSmc?oc=5", "fecha": "2026-09-28T04:36:00+00:00", "titulo": "Caravana de migrantes sale de Tapachula"}, {"medio": "Diario Tiempo de Honduras", "url": "https://news.google.com/rss/articles/CBMiigFBVV95cUxNTHNZU3JwVkpfNHlvU2wzUEpMLV82T3VRVWkybEtLRENqdExQVHlqMzZQWDRSbmtQMEdxQllUcjRNYTBTQWZZMmh2bk9ESWM5OVpsT3FUbnl5VktHeE5JMmVES2dILXc0U2p5TDExWS0tRUNFMkRTOS10WnRIVXN5