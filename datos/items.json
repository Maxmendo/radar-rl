l": "https://news.google.?oc=5", "medios": ["La República", "larepublica.pe", "N+"], "coberturas": [{"medio": "La República", "url": "https://news.google.?oc=5", "fecha": "2026-09-21T17:36:25+00:00", "titulo": "Terror para inmigrantes | Venezolano es gravemente herido de un disparo por agentes del ICE en Texas: Este es su estado actual"}, {"medio": "larepublica.pe", "url": "https://news.google.?oc=5", "fecha": "2026-09-21T17:36:25+00:00", "titulo": "Terror para inmigrantes | Venezolano es gravemente herido de un disparo por agentes del ICE en Texas: Este es su estado actual"}, {"medio": "N+", "url": "https://news.google.?oc=5", "fecha": "2026-09-22T05:02:20+00:00", "titulo": "Agente de ICE Dispara a Migrante Venezolano en Texas que Hacía Entregas en su Auto | En Punto | Video - N+"}], "velocidad": 3, "aceleracion": null, "trends": null, "horas": 22.8, "notas": 4, "otras_urls": ["https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5"], "ejes": ["deportaciones", "derechos_humanos"], "region": "Regional", "paises": ["US", "VE"], "paises_nombres": ["Venezuela", "Estados Unidos"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 9, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": ["VE"], "actores": ["organismos_migratorios"], "etapa": "destino", "tipo": "caso", "cobertura": 3, "confianza": 0.95, "tiene_fuente_primaria": false, "contiene_datos_personales": true, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "deportaciones", "angulo_sugerido": "Seguimiento médico y legal del caso de violencia institucional", "nota": "Duplicado temático sobre venezolano herido por ICE en Texas.", "fuentes_texto": [{"medio": "La República", "dominio": "larepublica.pe", "url": "https://larepublica.pe/latinos-en-usa/2026/09/21/terror-para-inmigrantes-venezolano-es-gravemente-herido-de-un-disparo-por-agentes-del-ice-en-texas-este-es-su-estado-actual-1077783", "texto": "Latinos en USA Terror para inmigrantes | Venezolano es gravemente herido de un disparo por agentes del ICE en Texas: Este es su estado actual Un agente del ICE disparó contra un migrante venezolano de 28 años en Austin, Texas. Wilber Garcés recibió un disparo y se encuentra en grave estado. Venezolano es gravemente herido de un disparo por agentes del ICE en Texas. | Composición larepublica.pe | Nicole Gonzales | flickr.com/ICE Nicole Gonzales Lunes 21 de Septiembre del 2026 · 12:36h La República en Google Resumen Escuchar Compartir Este domingo, un suceso lamentable ocurrió en Austin, Texas ya que un agente del Servicio de Inmigración y Control de Aduanas de Estados Unidos (ICE) disparó contra un migrante venezolano de 28 años. El hombre fue identificado como Wilber Garcés y, según informaron las autoridades locales , recibió un disparo en el torso.\n\nPuedes ver Terror para inmigrantes legales e indocumentados | Trabajadores reclamaron el pago de su sueldo y terminan siendo amenazados con el ICE\n\nCabe mencionar que Garcés fue trasladado rápidamente a un hospital, pero pese a ello, los especialistas indicaron que él se encuentra en condición grave.\n\nDe acuerdo con Mikel Siegel, concejal de la ciudad que acudió al lugar, un agente del ICE que estaba conduciendo una camioneta negra sin identificar interceptó el vehículo de Garcés, de color azul. El supuesto agente chocó contra el automóvil del venezolano, luego descendió de la camioneta para abrir fuego contra el vehículo.\n\nUn testigo identificado como Juan, quien pidió mantener en reserva su identidad para evitar represalias contra él, contó a la Agencia Efe que encontró a Garcés herido en el asiento del conductor. &quot;Le hablé al muchacho, le pregunté si estaba bien y me dijo: &#039;Me tiraron por la espalda&#039;&quot;. Según el relato, Garcés se veía cansado y sufriendo. Asimismo, expresó que el agente no se acercó a auxiliar al herido mientras llegaban las autoridades.\n\nDespués de unas horas del incidente, decenas de personas se reunieron en el lugar de los hechos con pancartas y banderas de México y Venezuela. Así se aprecia en un video difundido por Greg Stoker, activista de izquierda y candidato al Congreso de Estados Unidos , quien afirmó que los manifestantes ocuparon el sitio de manera pacífica.\n\nEl alcalde de Austin, Kirk Watson, y el concejal Siegel exigieron que se realice una investigación transparente por lo ocurrido y además expresaron su preocupación ante la posibilidad de que el agente involucrado abandone el estado antes de que se aclaren los hechos. &quot;Mi principal preocupación es que al sospechoso de este crimen se le impida salir de Texas&quot;, declaró Siegel.\n\nMientras que la jefa de la Policía de Austin, Lisa Davis, indicó que la policía local no participó en el operativo del ICE y que solamente intervino para controlar el tráfico y asegurar la zona tras el incidente.\n\nAdemás de ello, también se pronunció el representante demócrata por Texas, Greg Casar, quien exigió que se inicien una investigación independiente y la divulgación inmediata de las grabaciones de las cámaras corporales de los agentes involucrados. &quot;El horror ha llegado a nuestra ciudad: ICE disparó a una persona en Austin esta mañana&quot;, escribió en su cuenta de X.", "ok": true}, {"medio": "N+", "dominio": "nmas.com.mx", "url": "https://www.nmas.com.mx/sociedad/migracion/en-punto-video-agente-de-ice-dispara-a-migrante-venezolano-en-texas-que-hacia-entregas-en-su-auto/", "texto": "22 de septiembre de 2026 En Vivo En Vivo CDMX Sociedad Videos Estados Podcasts Entretenimiento Más En Vivo CDMX Sociedad Videos Estados Podcasts Entretenimiento Más Publicidad Derechos reservados Tritón Comunicaciones, S.A. de C.V., prohibido su uso o reproducción total o parcial. Transcripción Migración Agente de ICE Dispara a Migrante Venezolano en Texas que Hacía Entregas en su Auto Su abogada informó que fue trasladado desde el Centro de Detención de Pearsall a un hospital, pues tiene una bala alojada en la espalda. Es el segundo tiroteo de ICE en Texas en los últimos meses\n\nMás Videos Publicidad Categorías Última Hora Famosos Marchas y Bloqueos Ciencia y Tecnología Estado de México Clima Hoy N+ FORO Programas Sociales Última Hora Marchas y Bloqueos Estado de México N+ FORO Famosos Ciencia y Tecnología Clima Hoy Programas Sociales Quiénes Somos Newsletter Síguenos\n\nDerechos de Réplica Código de Ética y Defensoría de Audiencia Términos y Condiciones Aviso de Privacidad Sala de Prensa Cultura N+ Política de Cookies Contacto © 2026 Derechos reservados © Tritón Comunicaciones S.A de C.V.", "ok": true}]}, {"id": "6cdffb8ab1ba", "titulo_original": "Trump deporta a 25 mil 427 migrantes a países donde no nacieron: México recibe 8 de cada 10 expulsados", "url": "https://news.google.?oc=5", "medios": ["diariopresente.mx", "La Prensa de Coahuila", "XEVT"], "coberturas": [{"medio": "diariopresente.mx", "url": "https://news.google.com/rss/articles/CBMirwFBVV95cUxQZlBENmYtQUR4b1pSRTM4TS1MbVI2aF9ELWFlZE5ZNElvTVV4LWx3M0RWU084N0V3bVEwdXZYVng4VkV5YlliSmFodHZmc3hzb2lBRFNFRkwwdnpiX1pEd3h0bU5KNjR5YXdrcjVLYkEydF9NY0hLLV9Gc2ZpZVpKV2VoMHBrUC1hajI1aXdQbkRNdmpmSzk2Q2RqQjNsRW1mYkRhLU81MHVfVmNsRDJv?oc=5", "fecha": "2026-09-21T19:20:00+00:00", "titulo": "Estados Unidos deporta más de 25 mil migrantes a terceros países"}, {"medio": "La Prensa de Coahuila", "url": "https://news.google.?oc=5", "fecha": "2026-09-21T16:32:00+00:00", "titulo": "Trump deporta a 25 mil 427 migrantes a países donde no nacieron: México recibe 8 de cada 10 expulsados"}, {"medio": "XEVT", "url": "https://news.google.com/rss/articles/CBMiwwFBVV95cUxQSXRDNFBjWFg1QUdqOUdqaXFFN3Fkdnl2b3ZGLTlxQWNUVzhjVk1USWxKcEZyblVPVG5uN0ZKV1NQTVZCQUhFU1dVZ0NWRms4T1FfakZRRFp1RUNpMDNGT0JnbDVqbmFMLUZZTEJCN0p5bnppdUdjOWdvSnVOd1VPbmZxclVQT01kQllsdDRUY0Y2S0NkbXI4SUZuTTBTbGtab3lWYkRHTGs2dVF5RUdaenRGWW1pVUhUY1hRdVhseDJjamc?oc=5", "fecha": "2026-09-22T03:00:00+00:00", "titulo": "EE. UU. deportó más de 25 m