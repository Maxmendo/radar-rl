2cEVWMHFuY3pIaEZXemctRjhHSmlKWEJ5N1F1NzNHd01CbTBmSVExZUxKcG9ZRVdSLVJTYzVTcE84ZDNqRFVTc1Bo?oc=5", "fecha": "2026-09-22T19:17:34+00:00", "titulo": "Caen más de 50% las detenciones de migrantes centroamericanos en México y EU"}, {"medio": "oncenoticias.hn", "url": "https://news.google.com/rss/articles/CBMisgFBVV95cUxPWXZEZnpjZXFvMlo4NGZxcGR2akNSbmUwWjJGTnBnZklZT0xrMTQtWVYyVkpKMl9reDgxTDFWQnNEZWktcml6VGM1a1dTVzlmbUhRRzlzRFloRWpOZ2pIMDNiZGd2cmkxZTR2ZWNoNlNLWE9FVWMzVExaaVBtd3pCMlF0bDRiUEE4N05faGNaYVM0bGducXR4dks0X0pLN0RzTEtTNktxSU1lVEQxdldNSFl3?oc=5", "fecha": "2026-09-22T13:39:07+00:00", "titulo": "Detención de migrantes centroamericanos baja más del 50 % en EE.UU. y México"}, {"medio": "Proyecto Puente", "url": "https://news.google.com/rss/articles/CBMiuwFBVV95cUxOeHUzUE1oMFNDdXJzcGpfcWpBV2dNV1NhVmlOOG1fNXo0cmowaW1fLXc1VDRDQXBrZjNTNkFUcDgxZDRBTV9JWHEzSkpNYnJMV1NzUnBpQ3lyRXhadE9aaXFNSTBEREMxN3JfVkVEX0RXSFpwN2xQRWxReVdxRXZZV09rckw4aXhrek1CTUdvNzIwSDhzM3pUbXF6LWtvbVU3NW81a1V3aHU5LV83X2RtODRGQ0h2amFZYTIw?oc=5", "fecha": "2026-09-22T03:56:00+00:00", "titulo": "ICE oculta ubicación de miles de migrantes con órdenes finales de deportación"}, {"medio": "Telemundo Atlanta", "url": "https://news.google.?oc=5", "fecha": "2026-09-22T21:07:00+00:00", "titulo": "¿Dónde están los detenidos? ICE oculta la ubicación de miles de inmigrantes con órdenes de deportación"}, {"medio": "ultimasnoticias.com.ve", "url": "https://news.google.com/rss/articles/CBMiogFBVV95cUxOOUZSYkxERVpHcHBWeEZXdExKamNfTXBpbzZOb0NZdFNfRWFRVk8xS3FuRWtnRTktYkpiWC00UFpuamNwdFB4WEtGc0pIbVFNcHBmY0lDSU9oU3RmZzAzWmp3X05yNl8weDI4WVQ0RlZMQVBtYVJfSmVoNDE2VzZmQ2hkZ3ZQbDBsa2Q5QnJPTEM1WVRXRFdfUFBZMjByR1NJZ0E?oc=5", "fecha": "2026-09-23T00:30:00+00:00", "titulo": "ICE oculta a miles de migrantes con orden final de deportación"}], "velocidad": 10, "aceleracion": null, "trends": null, "horas": 23.6, "notas": 35, "otras_urls": ["https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5"], "ejes": ["deportaciones", "derechos_humanos"], "region": "Norteamérica", "paises": ["US"], "paises_nombres": ["Estados Unidos"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 8, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": [], "actores": ["organismos_migratorios", "sociedad_civil"], "etapa": "destino", "tipo": "caso", "cobertura": 7, "confianza": 0.95, "tiene_fuente_primaria": false, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "deportaciones", "angulo_sugerido": "Impacto de la opacidad en el acceso a la defensa legal de detenidos", "nota": "Denuncia sobre ocultamiento de paradero de detenidos por ICE.", "fuentes_texto": [{"medio": "La República", "dominio": "larepublica.pe", "url": "https://larepublica.pe/latinos-en-usa/2026/09/22/alerta-maxima-para-conductores-en-eeuu-esta-es-la-norma-que-el-ice-aprovecha-para-detener-a-mas-migrantes-con-licencias-de-conducir-554202", "texto": "Latinos en USA Alerta máxima para conductores en EE.UU. | Esta es la norma que el ICE aprovecha para detener a más migrantes con licencias de conducir El gobierno de Trump impone restricciones a la obtención de licencias comerciales no domiciliadas, afectando a ciertos inmigrantes y facilitando la labor del ICE. La norma que el ICE aprovecha para detener a más migrantes con licencias de conducir. | Composición larepublica.pe | Nicole Gonzales | Gemini Nicole Gonzales Martes 22 de Septiembre del 2026 · 08:58h La República en Google Resumen Escuchar Compartir El gobierno de Donald Trump mediante el Departamento de Transporte de EE.UU. impulsó una medida que frena a las personas están tramitando o renovando su licencia comercial no domiciliada. Esta restricción está sirviendo como una herramienta para que el Servicio de Inmigración y Control de Aduanas (ICE ) pueda identificar y detener a camioneros en rutas de todo el país.\n\nPuedes ver Alerta máxima en Walmart | Anciano es golpeado hasta las muerte por los padres de una trabajadora del supermercado: Este fue el insólito motivo\n\nDesde el pasado 16 de marzo, solo pueden conseguir o renovar una licencia comercial no domiciliada (CDL) aquellas personas que tengan visas H-2A, H-2B o E-2, de acuerdo con la Federal Motor Carrier Safety Administration (Fmcsa).\n\nTen en cuenta que solicitantes de asilo, asilados, refugiados y beneficiarios de DACA han quedado fuera de la elegibilidad para este tipo de licencia.\n\nAsimismo, cada licencia no domiciliada posee una validez máxima de un año, por lo que toda renovación tiene que hacerse en persona, con verificación del estatus migratorio mediante el sistema federal SAVE. Por ello, para el ICE es más sencillo ubicar a quienes tienen procesos de deportación pendientes o están de manera ilegal en el país.\n\nAhora, el ICE se dirige a las estaciones de pesaje, áreas de descanso y también a centros de viajes. Los agentes migratorios están solicitando los documentos de identidad y verifican si tu licencia comercial sigue vigente bajo los nuevos requisitos, de acuerdo con el testimonio recogido por Noticias Telemundo.\n\n&quot;Nos golpean las puertas y bajan a los choferes porque no tienen papeles o porque no tienen la licencia válida&quot;, contó un conductor entrevistado por Telemundo.\n\nPor su parte, NBC News indicó que más de una docena de videos, la gran mayoría grabados en agosto, muestran estos controles en diversos puntos del país, incluida una parada junto a la autopista de peaje de Nueva Jersey. Sin embargo, el Departamento de Seguridad Nacional (DHS) negó que los operativos estuvieran dirigidos a los conductores por su condición de inmigrantes.", "ok": true}, {"medio": "Telemundo Atlanta", "dominio": "telemundoatlanta.com", "url": "https://www.telemundoatlanta.com/2026/09/22/dnde-estn-los-detenidos-ice-oculta-la-ubicacin-de-miles-de-inmigrantes-con-rdenes-de-deportacin/", "texto": "(Telemundo Atlanta) - El Servicio de Inmigración y Control de Aduanas ( ICE ) dejó de revelar públicamente el lugar de reclusión de miles de inmigrantes bajo custodia que cuentan con órdenes definitivas de expulsión.\n\nLa medida, aplicada sin previo aviso oficial, imposibilita rastrear su paradero mediante las herramientas habituales, según información confirmada en un reporte de Noticias Telemundo .\n\nLa alteración en la base de datos ocurrió el 15 de septiembre , fecha en que la agencia retiró a estos inmigrantes del localizador de detenidos en internet . De acuerdo con tres funcionarios y exfuncionarios de la institución que hablaron bajo condición de anonimato, la decisión dificulta el seguimiento de los expedientes y frena recursos legales de última hora que podrían evitar las expulsiones.\n\nRepresentantes de la Asociación Estadounidense de Abogados de Inmigración (AILA) advirtieron a sus miembros sobre el problema tras detectar que múltiples clientes desaparecieron del registro.\n\nDatos del Proyecto de Datos sobre Deportación de U.C. Berkeley y UCLA señalan que en julio de este año cerca de 16,000 personas arrestadas en centros de detención (más de un tercio del total) tenían una orden definitiva de deportación .\n\nEn el estado de Georgia, donde miles de familias hispanas dependen de la transparencia de estos registros para dar seguimiento a familiares trasladados entre centros de detención locales, como las instalaciones de Folkston o Stewart, esta falta de visibilidad aumenta la zozobra y complica la representación legal oportuna.\n\nSi usted tiene un familiar en riesgo o bajo custodia, las organizaciones de derechos civiles recomiendan no esperar a que la persona aparezca en el sistema digital.\n\nMantenga siempre a mano el número de alien ( A-Number ) del detenido, copias de sus documentos judiciales y establezca comunicación inmediata con abogados locales autorizados para solicitar intervenciones directas ante las oficinas de campo de ICE.\n\nA pesar de contar con una orden final emitida por un juez de inmigración , las personas privadas de la libertad aún mantienen derechos constitucionales e instrumentos para apelar su expulsión. Entre las alternativas procesales vigentes se encuentran:\n\nSi necesita localizar a un ser querido o requiere orientación jurídica inmediata, puede consultar los siguientes recursos y canales directos:\n\nDerechos de autor 2026 WKTB. Reservados todos los derechos.", "ok": true}, {"medio": "Diario Libero", "dominio": "libero.pe", "url": "https://libero.pe/estados-unidos/2026/09/21/alerta-maxima-inmigrantes-legales-indocumentados-en-estados-unidos-aumentan-arrestos-de-extranjeros-licencia-asi-realizan-agentes-ice-redadas-usa-ee-uu-lbeu-1167453", "texto": "0 Últimas noticias Fútbol Peruano F. Internacional Deportes Ocio ESTADOS UNIDOS VIDEOS TEC LÍBERO Tiempo Extra Estados Unidos Inmigrantes ALERTA MÁXIMA, inmigrantes legales e indocumentados en EE. UU.: aumentan ARRESTOS de extranjeros con licencia; así realizan los agentes ICE las REDADAS ¿En qué zonas de EE. UU. se concentran las recientes redadas de ICE contra camioneros extranjeros y qué se sabe de estos operativos ?\n\nMelanni Miranda Actualizado el 22 Sep. 2026 | 20:00 H Incrementan los arrestos de camioneros con licencia en EE. UU.; así realizan los agentes ICE las redadas. | Composición Líbero / Melanni Miranda COMPARTIR Siguenos en Google News El Departamento de Seguridad Nacional (DHS) y el Servicio de Inmigración y Control de Aduanas (ICE) han intensificado recientemente sus inspecciones a camioneros extranjeros en diversos puntos de EE. UU. Estas intervenciones ocurren en áreas clave de tránsito como estaciones de pesaje y zonas de descanso, buscando endurecer el control y cumplimiento normativo en el sector del transporte.\n\nPUEDES VER: ALERTA MÁXIMA, inmigrantes legales e indocumentados en Miami, EE. UU.: hombre fingió ser agente de ICE para EXTORSIONAR A EMPLEADOS de un negocio\n\nRecientes videos difundidos en las redes sociales y compartidos por NBC News y La Nación evidencian múltiples detenciones de conductores en diferentes localidades del país americano, especialmente en estaciones de pesaje y otros puntos de control que se han convertido en focos de redadas .\n\nBajo este contexto , John Sandweg , exdirector del ICE de la administración de Barack Obama, se refirió a la dificultad que existe a la hora de identificar a inmigrantes que representen una amenaza real, como delincuentes violentos , señalando que &quot;podrías pasar decenas de horas&quot; en este proceso. En contraste, las autoridades optaron por realizar operaciones que resulten en arrestos rápidos en áreas donde podrían congregarse estos individuos.\n\nEntre los operativos más resaltantes por el gobierno federal figura Highway Shield , cuya segunda fase se llevó a cabo del 28 al 30 de julio. Según el Departamento de Seguridad Nacional (DHS) y la Administración Federal de Seguridad de Autotransportes (Fmcsa), se detuvieron a 51 inmigrantes indocumentados y se inhabilitaron 766 conductores y vehículos.\n\nA través de un comunicado a NBC News, un portavoz del DHS aclaró que estas operaciones no están dirigidas específicamente a los camioneros por su estatus migratorio. “El ICE busca a personas que se encuentran ilegalmente en el país e investiga el fraude que permite que conductores no calificados operen vehículos comerciales. Esto es de sentido común”, afirmó el DHS.\n\nLos operativos del ICE dirigidos a conductores con licencias comerciales (CDL) reflejan una estrategia centrada en la detección de fraudes migratorios, permisos laborales irregulares y el incumplimiento de requisitos federales para la conducción.\n\nEntre los hallazgos más relevantes, se ha mostrado que varios estados emitieron permisos no domiciliados que no se ajustan a las normativas federales, además de una incorrecta interpretación de los códigos migratorios. También se han registrado infracciones y arrestos por la falta de dominio del inglés, un requisito esencial para operar vehículos comerciales de carga.\n\nDHS ha señalado que su objetivo es retirar de las carreteras a conductores no calificados o sin estatus legal; defensores y expertos critican que se priorizan arrestos masivos y rápidos, en lugar de abordar amenazas más directas a la seguridad vial. ¡A tener cuidado!\n\nMelanni Miranda: últimas noticias, entrevistas exclusivas, columnas de opinión y artículos escritos en diario Libero.pe.\n\nParadox Park: Parque inmersivo donde Roma, Egipto y Grecia cobran vida con juegos, shows, etc\n\nFlying Squirrel: Full Day, 60 o 120 minutos según elijas en Jockey Plaza, San Miguel e Independencia.\n\nFun Jungle: Full Day o 60 minutos según elijas en los Inflables en El Defby y Parque de la Amistad\n\nCinepl", "ok": true}]}, {"id": "dd37c61ac748", "titulo_original": "Desplazamiento forzado impacta a dos millones de personas en México", "url": "https://news.google.com/rss/articles/CBMiXkFVX3lxTE5xWHRNNkRjSjBhajdYczE4WjF3R2xJeXl4bl9OYktyTTIzR24xWFI0cmFNZ0gxd00yYjR4TTA5eWRSM2lyalkxMzlqOTFtZlBJSmlYdkd3Z19EMnZMOGc?oc=5", "medios": ["El Informador", "Gobernantes.com", "Infobae", "La Jornada", "massinformacion.com.mx", "Notigram", "sdpnoticias", "Semanario ZETA"], "coberturas": [{"medio": "El Informador", "url": "https://news.google.?oc=5", "fecha": "2026-09-22T23:04:06+00:00", "titulo": "Inegi revela los 3 Estados con más personas desplazadas por violencia en México"}, {"medio": "Gobernantes.com", "url": "https://news.google.com/rss/articles/CBMiXkFVX3lxTE5xWHRNNkRjSjBhajdYczE4WjF3R2xJeXl4bl9OYktyTTIzR24xWFI0cmFNZ0gxd00yYjR4TTA5eWRSM2lyalkxMzlqOTFtZlBJSmlYdkd3Z19EMnZMOGc?oc=5", "fecha": "2026-09-22T20:43:46+00:00", "titulo": "México tiene 130.9 millones de habitantes, pero se hacen cada vez más mayores; edad promedio aumentó a 32 años"}, {"medio": "Infobae", "url": "https://news.google.?oc=5", "fecha": "2026-09-22T20:28:45+00:00", "tit