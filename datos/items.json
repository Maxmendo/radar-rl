oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5"], "ejes": ["deportaciones", "securitizacion"], "region": "Sudamérica", "paises": ["US"], "paises_nombres": ["Argentina", "Chile", "Paraguay"], "pais_inferido": true, "fuera_de_alcance": false, "importancia": 8, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": [], "actores": ["organismos_migratorios", "estado_nacional"], "etapa": "destino", "tipo": "normativa", "cobertura": 4, "confianza": 0.9, "tiene_fuente_primaria": false, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "deportaciones", "angulo_sugerido": "Analizar la capacidad y condiciones del nuevo centro de detención", "nota": "Conversión de infraestructura para ampliar capacidad de detención del ICE.", "fuentes_texto": [{"medio": "Telemundo", "dominio": "telemundo.com", "url": "https://www.telemundo.com/noticias/noticias-telemundo/inmigracion/una-prision-de-minnesota-se-convertira-en-un-centro-de-detencion-de-ic-rcna590988", "texto": "Jueza de Nueva York bloquea la ley que prohibía a agentes de ICE cubrir su rostro durante arrestos 00:35 Ag. 5, 2026, 1:29 PM EDT Por Brian Arola y Ana Radelat — The Associated Press\n\nEl Gobierno de Donald Trump concretó un plan que llevaba meses circulando como rumor: transformar una prisión privada ubicada en una zona rural del oeste de Minnesota en un centro de detención para inmigrantes indocumentados.\n\nCoreCivic, el gigante de la industria penitenciaria, anunció el martes que ha formalizado un contrato federal de cinco años para reabrir una prisión en Appleton cerrada desde hace mucho tiempo, que ahora albergará a inmigrantes detenidos.\n\nLa empresa estimó que su nuevo contrato con el Servicio de Inmigración y Control de Aduanas (ICE) generaría 75 millones de dólares al año.\n\nEl contrato de CoreCivic con ICE no es ninguna sorpresa. La empresa, propietaria de las instalaciones en Appleton, lleva muchos meses remodelando la prisión, conocida como Prairie Correctional Facility .\n\n&quot;Se le caía el pelo&quot;: venezolana denuncia condiciones precarias en centro de detención de ICE 01:06 La ciudad de Appleton construyó la cárcel, pero CoreCivic la compró en 1997 para albergar a presos estatales y luego la cerró en 2010 debido a la disminución de la demanda. En su momento fue el mayor empleador de la ciudad del condado de Swift.\n\nAhora albergará hasta 1,600 inmigrantes detenidos.\n\nCoreCivic indicó que espera comenzar a recibir detenidos a finales de este año, “y se estima que la puesta en marcha completa se logrará en el segundo trimestre de 2027”.\n\nLos planes para reutilizar edificios en Minnesota con fines de detención de inmigrantes —incluidas las propuestas de utilizar almacenes en las Twin Cities— han dividido a legisladores y han suscitado críticas por parte de grupos activistas.\n\nLa congresista Michelle Fischbach, quien representa al Dist rito 7 del Congreso, que incluye a Appleton, declaró el martes al diario MinnPost que se alegraba de saber que la prisión volvería a abrir sus puertas.\n\n“Sé que la comunidad ha brindado un gran apoyo para garantizar que podamos reabrirla, y tiene sentido”, afirmó. “Ya existe una instalación allí, por lo que no es necesario construir nada nuevo”.\n\n&quot;Voy a crecer sin padre&quot;: hija de inmigrante salvadoreño pide justicia tras su muerte 01:54 Su oponente, el demócrata Erik Osberg, vinculó el anuncio sobre la prisión con la ley One Big Beautiful Bill promulgada por Trump el año pasado, y añadió que se opone a la reapertura y que quiere derogar la legislación que la hizo posible.\n\n“En esa legislación hay un complejo industrial de deportación y centros de detención por valor de 180 mil millones de dólares”, señaló. “De eso se trata, y ¿adivinen quiénes se encargarán de construirlos y operarlos? Las empresas privadas”.\n\nLas reacciones ante la prisión también fueron las esperadas según las líneas partidistas a nivel estatal.\n\nEl senador estatal Torrey Westrom, republicano por Alexandria, afirmó que el contrato traerá empleos y oportunidades económicas a su distrito. Agradeció a Trump y a Fischbach por hacer realidad la reapertura de la prisión.\n\n“Este es un ‘gran y hermoso edificio’ y una inversión significativa que no debería haber permanecido desocupada durante tantos años”, declaró Westrom. “Cuando se cerró esta instalación, tuvo un impacto económico devastador en nuestra región y en nuestros residentes. Ponerla nuevamente en funcionamiento creará aproximadamente 450 nuevos empleos y proporcionará un importante impulso económico para Appleton y las comunidades de todo el centro-oeste de Minnesota”.\n\nAumentan los arrestos de inmigrantes en aeropuertos de todo EE.UU. 02:20 El presidente del Comité de Justicia y Seguridad Pública del Senado estatal, Ron Latz, por el DFL de St. Louis Park, calificó los planes como una afrenta para todos los habitantes de Minnesota.\n\n“Las historias y los reportajes sobre el trato que reciben las personas detenidas por ICE son espantosos y generan serias p", "ok": true}, {"medio": "América TeVé", "dominio": "americateve.com", "url": "https://www.americateve.com/es-oficial-una-prision-inactiva-zona-rural-minnesota-sera-centro-detencion-del-ice-n5458302", "texto": "�b#R�~��jV\u000f�:R\u0017����G�0�o����� �����}�kw����es�9�t�������>����M���ŭWI���S\u001a����\u0001�I\u0012*7hJ�\\B6m\u0018vg QJU�\u0004V �6'c��\u000f��J'S}������V��`̕e��M������� �ς�v7�O������id� o�9S6���\u000e�P��c����ҔJƏ�� \u00139�yO��Tq��g)��P��)�e.\u0005�Q\u00198��͹\u0005y!$\u001b ?9�n\u0012�еr@4[j#k�l��(\u0015��]�q $��\\)�R�\u0011��|�ڍ�����tw�|'GI=�`/{R�,_\b��Eu!L���\u0012r� ˰�RV\u000f.\u0018�+\u0007 a'>\u00122�) n�T ;���$� �������-�Yf��4\u0015��xj�R�H[����P��ɐ؝2a>li:�\u0013�l���\u0005�d5�� $[,�K�\u0015�� �X\b���ƈ\u0006m|4�J�)�`iUG���z \u0002�\u00113�L�\u001bI}Vns#��?��[���\u0011-\