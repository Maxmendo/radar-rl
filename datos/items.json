{"generado": "2026-09-04T10:47:37+00:00", "clasificado": true, "notas_totales": 232, "items": [{"id": "dcd15e4b63ea", "titulo_original": "La Casa Blanca crea un videojuego sobre la expulsión de inmigrantes", "url": "https://news.google.?oc=5", "medios": ["24 HORAS | El Diario sin Límites", "Clarin.com", "CódigoQro", "DW.com", "El Economista", "El Tiempo", "eltelegrafo.com.ec", "es-us.noticias.yahoo.com", "fmalpina.com.ar", "Grupo Animal", "La Vanguardia", "MILENIO", "N+", "Noticias RCN", "Perú 21", "Revista Semana", "TN", "tn.com.ar", "TVPerú", "Yahoo"], "coberturas": [{"medio": "24 HORAS | El Diario sin Límites", "url": "https://news.google.com/rss/articles/CBMikwFBVV95cUxPR21INEdmWjZqMmtPLXNNVlF4NTJoVENWeHRQWWlFRFUxTnhxNEdNbUVuSi1oM1dmX1NxZ0ZZWG9rbldsWF9ob2ZHYlRwYmxqcnFhNk5CWTAtUUhwTUNwVW9FM1o2X2V6dnoyZ0pMMU1jcDZKLWs2WjlnN1gxQzEteklqd01YV1FaSENndV9yWFdkUWM?oc=5", "fecha": "2026-09-04T00:13:21+00:00", "titulo": "Casa Blanca lanza 5 videojuegos sobre deportación de migrantes"}, {"medio": "Clarin.com", "url": "https://news.google.com/rss/articles/CBMiwAFBVV95cUxOR1NvbF9VUnMtSXlzTjhPNkFfQlZMdHlQR2pFQjN2SDVlUF9BVGU1NTJNNWUtdmtrTGFtRXZBRkJOMW5jOERzUXRWbGJRQS1zaXlZb3JBaGJWUjQ0T19fbUJvOWdERDlsQ1JEdS1BZ1UwdENpaXRjOXRlbjdiNEs4OUFjRTRLckw2UUZTNzNiQ2tXelJxR1ViWjJIWXJTZ1dpVC02MTN5STBfWmhtalNFSzg0MEV1bTNaNEx1ZkRIRFA?oc=5", "fecha": "2026-09-03T23:00:16+00:00", "titulo": "La Casa Blanca crea un videojuego sobre la expulsión de inmigrantes"}, {"medio": "CódigoQro", "url": "https://news.google.?oc=5", "fecha": "2026-09-04T01:30:00+00:00", "titulo": "La Casa Blanca lanza videojuego sobre la expulsión de inmigrantes"}, {"medio": "DW.com", "url": "https://news.google.?oc=5", "fecha": "2026-09-04T04:24:25+00:00", "titulo": "La Casa Blanca crea videojuego sobre expulsión de migrantes"}, {"medio": "El Economista", "url": "https://news.google.?oc=5", "fecha": "2026-09-03T23:57:08+00:00", "titulo": "La Casa Blanca lanza videojuego sobre la expulsión de inmigrantes"}, {"medio": "El Tiempo"