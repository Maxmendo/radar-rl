c=5", "medios": ["Diario Libero", "La República", "noticias.cubitanow.com", "Periódico Cubano"], "coberturas": [{"medio": "Diario Libero", "url": "https://news.google.?oc=5", "fecha": "2026-09-19T18:36:32+00:00", "titulo": "EXCELENTE NOTICIA, inmigrantes legales e indocumentados en EE. UU.: jueza LIMITA ARRESTOS de ICE sin orden en ESTE ESTADO y exige una condición específica"}, {"medio": "La República", "url": "https://news.google.?oc=5", "fecha": "2026-09-19T18:02:33+00:00", "titulo": "Buenas noticias para inmigrantes | Limitan arrestos del ICE sin una orden judicial en este estado de EE.UU."}, {"medio": "noticias.cubitanow.com", "url": "https://news.google.?oc=5", "fecha": "2026-09-19T23:21:11+00:00", "titulo": "Golpe al ICE jueza limita arrestos migratorios sin orden judicial en California"}, {"medio": "Periódico Cubano", "url": "https://news.google.?oc=5", "fecha": "2026-09-19T20:50:25+00:00", "titulo": "Jueza frena arrestos de ICE sin orden judicial a cubanos y otros migrantes en California"}], "velocidad": 4, "aceleracion": null, "trends": null, "horas": 16.7, "notas": 8, "otras_urls": ["https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5"], "ejes": ["deportaciones", "justicia"], "region": "Norteamérica", "paises": ["US"], "paises_nombres": ["Estados Unidos"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 8, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": [], "actores": ["poder_judicial", "organismos_migratorios"], "etapa": "destino", "tipo": "normativa", "cobertura": 6, "confianza": 0.9, "tiene_fuente_primaria": true, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "deportaciones", "angulo_sugerido": "Verificar en qué estado aplica y qué excepciones contempla la medida judicial", "nota": "Limitación a arrestos del ICE sin orden judicial. Impacto directo en la protección contra redadas.", "fuentes_texto": [{"medio": "La República", "dominio": "larepublica.pe", "url": "https://larepublica.pe/latinos-en-usa/2026/09/19/buenas-noticias-para-inmigrantes-limitan-arrestos-del-ice-sin-una-orden-judicial-en-este-estado-de-eeuu-1884287", "texto": "Latinos en USA Buenas noticias para inmigrantes | Limitan arrestos del ICE sin una orden judicial en este estado de EE.UU. La jueza federal de California, Maame Ewusi-Mensah Frimpong, prohíbe las detenciones civiles del ICE sin mandato judicial, protegiendo a inmigrantes. Limitan arrestos del ICE sin una orden judicial en este estado de EE.UU. | Composición larepublica.pe | Nicole Gonzales | ICE.gov Nicole Gonzales Sábado 19 de Septiembre del 2026 · 13:02h La República en Google Resumen Escuchar Compartir Una gran noticia para inmigrantes pues la jueza federal de California, Maame Ewusi-Mensah Frimpong, emitió una medida cautelar que prohíbe las detenciones civiles por parte de agentes del Servicio de Inmigración y Control de Aduanas (ICE) y que no cuenten con un mandato judicial explícito.\n\nPuedes ver Atención inmigrantes | Este es el cambio que el USCIS aplicará desde HOY para quienes tramiten su Green Card\n\nSi se determina que la condición migratoria irregular no justifica un arresto discrecional, la medida establece un precedente legal que salvaguarda el debido proceso y además brinda protección a miles de extranjeros que buscan regularizar su estatus en EE.UU.\n\nTen en cuenta que la orden judicial contempla el Distrito Central de California , un área que comprende siete condados clave: Los Ángeles, Orange, Riverside, San Bernardino, Ventura, Santa Bárbara y San Luis Obispo.\n\nDe acuerdo con lo informado por la agencia Associated Press y el periódico La Opinión, la magistrada señaló que los agentes migratorios tendrán que evaluar la totalidad de las circunstancias conocidas por el agente o funcionario antes de actuar. Además, instó al gobierno a que los obligue a documentar la causa probable que respalde cada intervención.\n\nCabe mencionar que el origen de esta batalla se remonta a una demanda interpuesta por la Unión Americana de Libertades Civiles (ACLU) del Sur de California y Public Counsel, organizaciones que denunciaron arrestos sistemáticos sin evaluaciones individuales de riesgo. &quot;Esta orden judicial debería poner fin a cientos, si no más, de arrestos ilegales que continúan en todo el sur de California&quot;, indicó Mayra Joachin, abogada de la ACLU.\n\nTen en cuenta que este ajuste en las políticas de control migratorio no impide que las autoridades realicen detenciones, pero sí impone un filtro estricto que protege a los migrantes de operativos arbitrarios.\n\nPor último, para los inmigrantes de la región, esta medida representa un respiro frente a los arrestos relámpago, al establecer que la revisión del riesgo de fuga es un requisito obligatorio para que se utilicen las fuerzas de seguridad.", "ok": true}, {"medio": "Diario Libero", "dominio": "libero.pe", "url": "https://libero.pe/estados-unidos/2026/09/17/excelente-noticia-inmigrantes-legales-indocumentados-en-estados-unidos-jueza-limita-arrestos-de-ice-sin-orden-en-estado-exige-condicion-especifica-ee-uu-usa-lbeu-1178304", "texto": "0 Últimas noticias Fútbol Peruano F. Internacional Deportes Ocio ESTADOS UNIDOS VIDEOS TEC LÍBERO Tiempo Extra LO ÚLTIMO Así quedó el Acumulado tras derrota de la &#x27;U&#x27; Estados Unidos Inmigrantes EXCELENTE NOTICIA, inmigrantes legales e indocumentados en EE. UU.: jueza LIMITA ARRESTOS de ICE sin orden en ESTE ESTADO y exige una condición específica California rechazó los arrestos migratorios sin orden judicial, obligando a revisar cada expediente para garantizar estos procesos. ¿Es un recurso de apoyo?\n\nMaría Zapata Actualizado el 19 Sep. 2026 | 13:36 H Una jueza limitó los arrestos de ICE sin orden judicial en California. | Composición: María Zapata, Líbero COMPARTIR Siguenos en Google News Un fallo significativo para el Servicio de Inmigración y Control de Aduanas ( ICE ) se produjo cuando la jueza federal de California , Maame Ewusi-Mensah Frimpong, dictó una orden cautelar que impide las detenciones civiles de migrantes sin un mandato judicial claro, salvo que se presente evidencia sólida de riesgo de fuga. Al concluir que la condición de migrante irregular no justifica un arresto discrecional, esta decisión establece un precedente legal que protege el debido proceso y ofrece resguardo a miles de extranjeros que intentan regularizar su situación en el país.\n\nPUEDES VER: ALERTA MÁXIMA, inmigrantes legales e indocumentados EE. UU.: ICE ARRESTA a hombre con ANTECEDENTES; era buscado tras abusos y otros delitos\n\nLa orden judicial abarca el Distrito Central de California, un área que comprende siete condados clave: Los Ángeles, Orange, Riverside, San Bernardino, Ventura, Santa Bárbara y San Luis Obispo. Según informaron la agencia Associated Press y el periódico La Opinión , la magistrada enfatizó que las autoridades federales deben evaluar &quot;la totalidad de las circunstancias conocidas por el agente o funcionario&quot; antes de actuar, e impuso al gobierno la obligación de documentar detalladamente la causa probable que respalde cada intervención.\n\nEl origen de esta batalla legal se remonta a una demanda interpuesta por la Unión Americana de Libertades Civiles (ACLU) del Sur de California y Public Counsel, organizaciones que denunciaron arrestos sistemáticos sin evaluaciones individuales de riesgo. La evidencia presentada incluyó videos en los que la versión oficial sobre supuestas &quot;fugas&quot; quedaba desmentida al mostrar a las personas caminando con normalidad. Mayra Joachin, abogada de la ACLU, celebró la medida señalando: &quot;Esta orden judicial debería poner fin a cientos, si no más, de arrestos ilegales que continúan en todo el sur de California&quot;.\n\nEste ajuste en las políticas de control migratorio no impide que las autoridades realicen detenciones, pero impone un filtro estricto que protege a los migrantes de operativos arbitrarios . Al rechazar la solicitud del gobierno para congelar la aplicación del fallo mientras se tramita la apelación, la jueza garantizó que la protección entre en vigor de inmediato.\n\nEsta decisión alinea al sur del estado con fallos similares dictados en jurisdicciones como Oregón, Colorado, Washington D. C. y el Distrito Este de California, lo que refuerza las garantías procesales en Estados Unidos . Para la población extranjera de la región, la medida representa un respiro frente a los arrestos relámpago, al establecer que la revisión del riesgo de fuga es un requisito obligatorio e ineludible para las fuerzas de seguridad.\n\nRedactora en la web del Diario Líbero, sección Ocio y México. Egresada de Comunicación y Periodismo (UPC) con 2 años de experiencia en contenido digital. Interesada en anime, tecnología y crónicas.\n\nParadox Park: Parque inmersivo donde Roma, Egipto y Grecia cobran vida con juegos, shows, etc\n\nFlying Squirrel: Full Day, 60 o 120 minutos según elijas en Jockey Plaza, San Miguel e Independencia.\n\nFun Jungle: Full Day o 60 minutos según elijas en los Inflables en El Defby y Parque de la Amistad\n\nCineplanet: 2 Entradas 2D + 2 Bebidas Grandes + Pop corn g", "ok": true}, {"medio": "noticias.cubitanow.com", "dominio": "noticias.cubitanow.com", "url": "https://noticias.cubitanow.com/golpe-al-ice--jueza-limita-arrestos-migratorios-sin-orden-judicial-en-california", "texto": "Redacción de CubitaNOW ~ sábado 19 de septiembre de 2026\n\nUna jueza federal ordenó a los agentes de ICE realizar una evaluación individual antes de efectuar determinados arrestos migratorios sin orden judicial en siete condados del sur de California, una medida que alcanza a inmigrantes de distintas nacionalidades, incluidos cubanos.\n\nUna nueva resolución judicial impone límites a los arrestos civiles sin orden judicial que realiza el Servicio de Inmigración y Control de Aduanas (ICE) en el sur de California. La decisión fue emitida por la jueza federal Maame Ewusi-Mensah Frimpong, dentro del caso Vasquez Perdomo v. Mullin, y fue divulgada públicamente el 16 de septiembre.\n\nLa orden establece que, cuando los agentes pretendan realizar un arresto migratorio sin una orden judicial, no basta con considerar que una persona se encuentra en Estados Unidos en situación migratoria irregular. Antes de detenerla, deberán realizar una evaluación individualizada para determinar si existe una causa probable para considerar que podría escapar antes de que sea posible obtener una orden.\n\nAdemás, los agentes deberán dejar constancia de los hechos que sustentan esa determinación. La medida se aplica al Distrito Central de California y forma parte de una acción colectiva relacionada con arrestos realizados desde el 6 de junio de 2025.\n\nEl caso surgió a partir de denuncias presentadas por trabajadores y organizaciones que cuestionaron determinadas prácticas utilizadas durante operativos migratorios en California. Entre los demandantes figuran cinco personas detenidas durante esas operaciones y organizaciones como la Coalición por los Derechos Humanos de los Inmigrantes, United Farm Workers y Los Angeles Worker Center Network.\n\nLa resolución también aborda la forma en que ICE justificaba algunos arrestos. Según los documentos judiciales citados durante el proceso, la corte examinó registros en los que no aparecía una evaluación individual del riesgo de fuga o en los que se utilizaban explicaciones generales.\n\nLa decisión llega después de otros enfrentamientos judiciales relacionados con las prácticas de inmigración de la administración federal. El propio expediente muestra que el gobierno ha cuestionado varias de las decisiones adoptadas durante el proceso y que el litigio continúa abierto.\n\nPara los inmigrantes cubanos que viven en los condados afectados, la orden establece un nuevo requisito procesal para determinados arrestos sin orden judicial, pero no elimina la autoridad federal para aplicar las leyes migratorias ni significa que una persona en situación irregular quede exenta de una posible detención. La resolución se refiere específicamente a las condiciones que deben cumplirse antes de determinados arrestos sin orden judicial.\n\nCubitaNOW es un espacio dedicado a todos los cubanos con el fin de la unión a través del debate con respeto, el entretenimiento y la nostalgia en momentos difíciles para el pueblo de Cuba. Nuestra misión es informar y entretener a cada cubano alrededor del mundo.", "ok": true}]}, {"id": "3deeeeaf9be8", "titulo_original": "La policía de Guinea Ecuatorial detiene y golpea a dos deportados de Estados Unidos, según reportes de sus abogados", "url": "https://news.google.?oc=5", "medios": ["El Nuevo Día", "El Tiempo", "Telemundo", "Univision"], "coberturas": [{"medio": "El Nuevo Día", "url": "https://news.google.?oc=5", "fecha": "2026-09-19T14:23:08+00:00", "titulo": "Deportados de Estados Unidos a Guinea Ecuatorial fueron arrestados y golpeados por la policía"}, {"medio": "El Tiempo", "url": "https://news.google.?oc=5", "fecha": "2026-09-20T04:15:00+00:00", "titulo": "Las relaciones con Estados Unidos"}, {"medio": "Telemundo", "url": "https://news.google.?oc=5", "fecha": "2026-09-19T17:30:21+00:00", "titulo": "Inmigrantes deportados desde EE.UU. a Guinea Ecuatorial son arrestados y golpeados por la policía, según sus abogados"}, {"medio": "Univision", "url": "https://news.google.?oc=5", "fecha": "2026-09-19T14:27:40+00:00", "titulo": "La policía de Guinea Ecuatorial detiene y golpea a dos deportados de Estados Unidos, según reportes de sus abogados"}], "velocidad": 4, "aceleracion": null, "trends": null, "horas": 20.4, "notas": 5, "otras_urls": ["https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5"], "ejes": ["deportaciones", "derechos_humanos"], "region": "Norteamérica", "paises": ["US", "GQ"], "paises_nombres": ["Estados Unidos"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 9, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": [], "actores": ["sociedad_civil"], "etapa": "retorno", "tipo": "caso", "cobertura": 6, "confianza": 0.9, "tiene_fuente_primaria": false, "contiene_datos_personales": false, "requiere_verificacion": true, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "deportaciones", "angulo_sugerido": "Revisar las garantías de los deportados al llegar a sus países de origen", "nota": "Denuncia de abusos a deportados. Alta gravedad institucional.", "fuentes_texto": [{"medio": "El Tiempo", "dominio": "eltiempo.com", "url": "https://www.eltiempo.com/amp/opinion/columnistas/las-relaciones-con-estados-unidos-3587391", "texto": "Profesor Escuela de Asuntos Públicos e Internacionales (SIPA) de la Universidad de Columbia, Nueva York 19.09.2026 23:15 Actualizado: 20.09.2026 00:01 La reunión del presidente de la República, Abelardo De La Espriella, con el secretario de Estado de Estados Unidos, Marco Rubio, servirá, sin duda, para renovar las estrechas relaciones con la potencia mundial del norte de nuestro hemisferio. Entre los acuerdos, el primero que se debe resaltar es el apoyo a los esfuerzos de Colombia por combatir las múltiples organizaciones armadas y, en conjunto con otros países, la criminalidad transnacional. Esta cooperación no debe involucrar, sin embargo, la participación directa de las fuerzas armadas de Estados Unidos en nuestro país, ni utilizar el método de asimilar a los supuestos traficantes de drogas a terroristas. Un tema relacionado es la lucha contra el cultivo de coca, que ha crecido en forma dramática durante los tres últimos gobiernos, aumentando de menos de 50.000 a más de 260.000 hectáreas, convirtiendo además a la cocaína en el principal producto de exportación del país, de acuerdo con algunos economistas. Cabe resaltar que, debido a la falta de avance en la lucha contra las drogas, Colombia fue nuevamente descertificada por Estados Unidos. Esta lucha debe ser integral e incluir la erradicación manual y la aspersión o fumigación terrestre o aérea, evitando en estos últimos casos los riesgos para la salud y el medio ambiente. Aún más importante es el apoyo a cultivos alternativos para los pequeños cocaleros, que debe estar en el centro de las políticas del Ministerio de Agricultura y contar con apoyo de Estados Unidos. Este país debe, además, combatir en forma mucho más firme el consumo, que es la fuente de la demanda de este producto. En relación con el comercio bilateral, resultó sorprendente que, aunque Marco Rubio mencionó que las negociaciones para la eliminación del arancel del 12,5 % han avanzado, no haya hecho una declaración firme en este campo. Cabe recordar que, de acuerdo con la Cámara de Comercio Colombo Americana, ese arancel se aplica a la quinta parte de las exportaciones colombianas a Estados Unidos. Más aún, si se reduce nuevamente al 10 %, seguirá siendo contraria al acuerdo de libre comercio de 2006. Fue interesante, además, el convenio específico sobre tierras raras y minerales críticos, que beneficia a los recientes descubrimientos de tungsteno en Caldas, pero, sobre todo, a la explotación de cobre, que tiene grandes posibilidades en Colombia. Infortunado que el tema de la migración no haya recibido atención en el encuentro. Estados Unidos es el principal destino de migrantes colombianos, seguido por España, que ya está alcanzando niveles similares y ofrece condiciones más favorables a los migrantes. El apoyo a la migración irregular debe seguir siendo un elemento de la cooperación, así como la recepción de los migrantes irregulares deportados por Estados Unidos, aunque siguiendo en este último caso lo rige el derecho internacional sobre la materia. Resultó sorprendente que, aunque Marco Rubio mencionó que las negociaciones para la eliminación del arancel del 12,5 % han avanzado, no haya hecho una declaración firme en este campo Es clave que las relaciones con Estados Unidos continúen teniendo como marco el apoyo bipartidista en ese país, que ha sido un tema esencial por mucho tiempo. Es, además, importante ante la posibilidad de un triunfo de los demócratas en las elecciones del Congreso en noviembre. Igualmente, estas relaciones bilaterales no pueden limitar la autonomía nacional en materia internacional, ni fomentar la división entre los países latinoamericanos. Así, Colombia debe seguir apoyando a las Naciones Unidas y tener políticas muy activas con Europa, Canadá y los países asiáticos, entre ellos China, que debe ser un destino más importante de nuestras exportaciones. Por su parte, el Escudo de las Américas debe preservar la buena vecindad, la autonomía y la soberanía de los países. La mejora de ", "ok": true}, {"medio": "Telemundo", "dominio": "telemundo.com", "url": "https://www.telemundo.com/noticias/noticias-telemundo/inmigracion/inmigrantes-deportados-desde-eeuu-guinea-ecuatorial-son-arrestados-rcna598695", "texto": "Inmigrantes deportados a África a denuncian actos de violencia en su contra 02:11 Sept. 19, 2026, 1:30 PM EDT Por Monika Pronczuk - The Associated Press\n\nDos inmigrantes deportados por Estados Unidos a Guinea Ecuatorial fueron detenidos arbitrariamente después de que la policía les cubriera la cabeza con una bolsa, los golpeara y los mantuviera a punta de pistola en un hotel convertido en centro de detención, informaron el viernes sus abogados y organizaciones de derechos humanos.\n\nAhmed Soliman, ciudadano egipcio, y Samson Birhane, de Eritrea, figuran entre las más de 40 personas que han sido deportadas por Estados Unidos a Guinea Ecuatorial, un pequeño estado rico en petróleo de África Central. Los abogados señalaron que, en su opinión, las detenciones arbitrarias fueron una represalia por haber alertado sobre las condiciones de su detención y la violencia policial que habían sufrido.\n\n[EE.UU. manda a Guinea Ecuatorial a deportados que se negaron a bajar de un vuelo en Liberia]\n\nLas autoridades los mantienen en un hotel en las afueras de Malabo que el mandatario de larga data del país, Teodoro Obiang Nguema Mbasogo, convirtió en una prisión para solicitantes de asilo enviados desde Estados Unidos en virtud de un acuerdo opaco de 7.5 millones de dólares con el Gobierno del presidente, Donald Trump. A principios de este año, la agencia The Associated Press obtuvo acceso exclusivo al hotel.\n\nTrump ha deportado a miles de personas a casi dos docenas de terceros países en virtud de una serie de acuerdos poco transparentes. Defensores de derechos humanos sostienen que los traslados forman parte de una ofensiva más amplia para disuadir la inmigración.\n\nJueces estadounidenses habían protegido a la mayoría de los deportados a Guinea Ecuatorial para que no fueran devueltos a sus países de origen. Aun así, 12 personas han sido enviadas de regreso a sus países, según sus abogados, entre ellos, cuatro etíopes este mes.\n\nEl Hotel Bamy donde están los inmigrantes deportados desde EE.UU. Monika Pronczuk / AP file Quienes permanecen detenidos en el Hotel Bamy han enfrentado violencia por parte de las autoridades, que intentaron confiscarles los teléfonos, indicaron sus abogados.\n\n“En los últimos meses, hemos observado un aumento de los casos de violencia policial”, señaló Isabella Mosselmans, directora de Global Litigation Council, una organización que forma parte de una coalición que representa a las personas detenidas en Malabo. “El 31 de julio, agentes de policía ecuatoguineanos enmascarados irrumpieron en las habitaciones de cinco personas (...) y las agarraron por el cuello, las derribaron, las esposaron y las amenazaron a punta de pistola”.\n\nLas autoridades intentaron presionar a Soliman y Birhane para que aceptaran ser devueltos a sus países, dijeron sus abogados, y trataron de quitarles sus teléfonos. Medios internacionales han publicado videos de Soliman protestando por el maltrato mientras un agente en el hotel le apunta con una pistola.\n\n[EE.UU. deporta a otros dos latinos a Esuatini, la última monarquía absoluta de África]\n\nLa policía arrestó a Soliman y Birhane el 11 de septiembre, acusándolos de romper un espejo. Los agentes los llevaron de vuelta al hotel con bolsas sobre la cabeza y los golpearon delante de otros detenidos, según los abogados quienes dijeron que no han podido comunicarse con sus clientes desde que las autoridades los trasladaron a la comisaría de La Luna.\n\nAmbos habían vivido en Estados Unidos durante décadas antes de ser deportados.\n\n“Amnistía Internacional cree que los policías los atacaron como represalia por denunciar las amenazas violentas de las autoridades para coaccionarlos a aceptar ser devueltos a sus países de origen”, señaló el organismo el viernes en un comunicado. “Desde entonces, ambos han permanecido en una celda policial hacinada, en condiciones inhumanas, sin poder hablar con su abogado”.\n\n&quot;Nos comenzó a disparar con armas de goma&quot;: nicaragüense narra cómo fue deportado de EE.UU. a", "ok": true}, {"medio": "Univision", "dominio": "univision.com", "url": "https://www.univision.com/noticias/inmigracion/la-policia-de-guinea-ecuatorial-detiene-y-golpea-a-dos-deportados-de-estados-unidos-segun-reportes-de-sus-abogados", "texto": "�� \u0011\u0015� \u0002�HY8��T�?]��UM�\u0012�DJ��^�~�x4K`I�\u0002\u0001\u0018\u0000U�~ P��׷�t\u0003�q%�� O���]�1\u0003���37�`L�k�}���&^��,��X�z�̒�\u0005�H��>�S�m� \u0017��dġ�b oO��%���M����h{��f�y��$\u0003��잛�\u0019̆�A�\\�\u000f���tS�,�`?�\u0017��/�O^\u0014�Ĕ����p�ț�E��F�(>i�E�I�UE�S^�u�m��7m��+�\u0014M�����R�2�rUm+Q�N�jC���fSqQ��ɿ}�\u0017�F\u001a�K?�\u001a�zs^\u0002X �B���B���j��U8mUSj�Wu8^=�����\u001a�*th6�Ͻٴ\u0001jP�\u0013�\u0019� �V,��s�y\u000f�G�����mA�vp ����8��Њ��\u0007\u000ffX��Π�G(�\u0001��8�c\\��)/�Ǯt��X�b\u0007�\\ X�b+y�%��\u000e>xʩ��X[���.\u0006�(®����A�I��\u0005�N�}f�\u0019�V�\