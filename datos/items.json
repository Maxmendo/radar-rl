iere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "migraciones", "angulo_sugerido": "Analizar tensiones internas en el partido gobernante sobre el alcance de las medidas migratorias", "nota": "Crítica política a la política migratoria desde el propio oficialismo."}, {"id": "512b869883ca", "titulo_original": "Chile permitirá que venezolanos con pasaporte vencido salgan del país con un simple salvoconducto", "url": "https://news.google.?oc=5", "medios": ["ADN Radio", "Epicentro Chile", "Infobae", "Radios Regionales", "tarapacaonline.cl"], "coberturas": [{"medio": "ADN Radio", "url": "https://news.google.?oc=5", "fecha": "2026-09-16T23:51:36+00:00", "titulo": "Gobierno tramita salvoconducto especial para salida de venezolanos con pasaporte vencido tras anular circular administrativa"}, {"medio": "Epicentro Chile", "url": "https://news.google.?oc=5", "fecha": "2026-09-17T01:31:38+00:00", "titulo": "Salida con pasaporte vencido: Subsecretario Máximo Pavez anuncia homologación de salvoconducto para venezolanos"}, {"medio": "Infobae", "url": "https://news.google.?oc=5", "fecha": "2026-09-17T15:31:06+00:00", "titulo": "Chile permitirá que venezolanos con pasaporte vencido salgan del país con un simple salvoconducto"}, {"medio": "Radios Regionales", "url": "https://news.google.com/rss/articles/CBMimAFBVV95cUxQUEVlM3d4TEJGaDZFYkNSZjRfZkpnUWc0Vk9tdi1WT0ZfVE4yelNhczVTMmo1MmRIVkZOa3AtQ0lIWTZ1bjhacHU1UGVZR05DNGh4R1FQRDNSSUFBZUlsVlh5R0N2VTZaNHZFQXQtdlJGSmlCVjBfUVVPQ2U0Z3A3QWxzbUwtU24xUWVDZ1Z6dnJabXl3VjRJcw?oc=5", "fecha": "2026-09-17T16:13:00+00:00", "titulo": "Gobierno permitirá la salida de venezolanos con pasaporte vencido"}, {"medio": "tarapacaonline.cl", "url": "https://news.google.com/rss/articles/CBMizgFBVV95cUxOczVkMnNZWEZOY3JuRm9pSFBFeFhuWGhicWtiUDBCN2YweHVjNS0zVVA4VnBpNmQzVy1ZREZjckR5bWpGNGxvVGtnUTBSdTN4d3o2OEZqQ2NrdFJReXM5dlZ3N2JlMFRvS1FHeU9zelpfejZOUkZWOTItVVA4X05ucVdiZ0J6blZpMHlCc1YyYUZuY2kzcGp5RnAySVNyVHpGcGhmQWFnRkM4bWRyS0NLUldfSjZSd25NWmtrMG1haWpfeDZ5S05YbUlmMTlDQQ?oc=5", "fecha": "2026-09-17T14:42:23+00:00", "titulo": "Gobierno prepara salvoconducto para que venezolanos con pasaporte vencido puedan salir de Chile"}], "velocidad": 5, "aceleracion": null, "trends": null, "horas": 23.6, "notas": 11, "otras_urls": ["https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.com/rss/articles/CBMizgFBVV95cUxOczVkMnNZWEZOY3JuRm9pSFBFeFhuWGhicWtiUDBCN2YweHVjNS0zVVA4VnBpNmQzVy1ZREZjckR5bWpGNGxvVGtnUTBSdTN4d3o2OEZqQ2NrdFJReXM5dlZ3N2JlMFRvS1FHeU9zelpfejZOUkZWOTItVVA4X05ucVdiZ0J6blZpMHlCc1YyYUZuY2kzcGp5RnAySVNyVHpGcGhmQWFnRkM4bWRyS0NLUldfSjZSd25NWmtrMG1haWpfeDZ5S05YbUlmMTlDQQ?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5"], "ejes": ["estatus", "politica_migratoria"], "region": "Sudamérica", "paises": ["CL", "VE"], "paises_nombres": ["Venezuela"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 8, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": ["VE"], "actores": ["estado_nacional"], "etapa": "destino", "tipo": "normativa", "cobertura": 5, "confianza": 0.95, "tiene_fuente_primaria": true, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "migrantes venezolanos", "angulo_sugerido": "Verificar los requisitos concretos y vigencia del salvoconducto para salir del país", "nota": "Cambio normativo que facilita la salida de personas con pasaporte vencido.", "fuentes_texto": [{"medio": "Infobae", "dominio": "infobae.com", "url": "https://www.infobae.com/america/america-latina/2026/09/17/chile-permitira-que-venezolanos-con-pasaporte-vencido-salgan-del-pais-con-un-simple-salvoconducto/?outputType=amp-type", "texto": "Durante los últimos días, varios ciudadanos venezolanos que llegaron con sus pasajes comprados hasta el Aeropuerto de Santiago para viajar de vuelta a su país se encontraron con la desagradable sorpresa de que no podían abandonar Chile , pues portaban pasaportes vencidos , asunto que provocó que algunos incluso tuvieran que pasar la noche en el terminal aéreo.\n\nEste miércoles, el subsecretario del Interior, Máximo Pavez , explicó la razón del malentendido y anunció que ya implementaron una solución que estará operativa en los próximos días: un nuevo salvoconducto simple que será reconocido por ambos países.\n\n“¿Qué es lo que pasa? La ley de migraciones solo permite la salida del país de personas que tienen pasaporte vigente, documento válido o salvoconducto”, comenzó explicando la autoridad.\n\nSin embargo, entre el 2024 y el 2026 “estuvo vigente una circular emitida por el gobierno anterior que permitía la salida de ciudadanos venezolanos con pasaporte vencido . El análisis del gobierno era que dicha resolución adolecía de una ilegalidad y nos exponíamos a estar permitiendo, a través de un documento administrativo, la salida de personas de Venezuela sin cumplir con la ley”, agregó.\n\nDebido a esto, el Gobierno dejó sin efecto dicha circular el 16 de agosto , “entonces, como no hay relaciones consulares con Venezuela y, por lo tanto, no se pueden expedir en Chile todavía pasaportes vigentes, la única solución para aquellos ciudadanos venezolanos que quieran salir del país con pasaporte vencido es obtener un salvoconducto”, complementó Pavez.\n\nSin embargo, “el Gobierno venezolano no nos había pedido formalmente reconocer el salvoconducto que ellos tienen en su página web como oficial, pero ya hicieron la solicitud anoche”, detalló.\n\nEl secretario de Estado resumió que “hoy día tenemos la resolución, la solicitud del gobierno venezolano, y apenas la Cancillería, a través de una resolución que va a ser dictada el día de hoy o el día de mañana (jueves), va a homologar como documento de viaje ese salvoconducto expedido por el gobierno venezolano”.\n\nAsí, “todos los venezolanos que tengan ese salvoconducto van a poder salir del país, aunque no tengan pasaporte, y aunque no hayan entrado por paso habilitado (...) Esa es una dificultad que significa no tener relaciones diplomáticas ni consulares con un país, porque el trámite migratorio requiere, en el país que sale la persona y en el país que entra, la documentación que permite este tránsito. Nosotros esperamos que esto quede lo antes posible solucionado”, aseguró el ministro.\n\nEso sí, “las personas que ingresaron por paso no habilitado y que por este mecanismo puedan salir, van a tener la sanción de prohibición de ingreso (...) Una vez que ese trámite esté finalizado, va a ser informado en la opinión pública para que todos los ciudadanos de Venezuela puedan viajar a su país. Lamentamos que alguna falta de información o confusión haya impedido que personas con pasaje comprado hayan podido salir de Chile”, remató Pavez.\n\nTemas Relacionados Chile Venezuela Salvoconducto Máximo Pavez Pasaporte PUBLICIDAD", "ok": true}, {"medio": "ADN Radio", "dominio": "adnradio.cl", "url": "https://www.adnradio.cl/2026/09/16/gobierno-tramita-salvoconducto-especial-para-salida-de-venezolanos-con-pasaporte-vencido-tras-anular-circular-administrativa/?outputType=amp", "texto": "La medida previa fue dejada de lado por las autoridades actuales tras detectar que contravenía la legislación vigente en materia migratoria.\n\nEl Gobierno inició la tramitación de un salvoconducto especial de emergencia diseñado para resolver la situación de miles de ciudadanos venezolanos que no cuentan con pasaporte vigente y buscan abandonar el país, luego de que el pasado 16 de agosto quedara sin efecto una circular del año 2024 que permitía su libre tránsito .\n\nLa medida previa fue dejada de lado por las autoridades actuales tras detectar que contravenía la legislación vigente en materia migratoria , sumado a la imposibilidad de renovar documentación en Chile debido a la ausencia de servicios consulares venezolanos operativos.\n\nEl subsecretario del Interior, Máximo Pavez , detalló el sustento jurídico que motivó la rectificación de los criterios de control y el mecanismo de salida proyectado.\n\n“La Ley de Migraciones solo permite la salida del país de personas con pasaporte vigente, documento válido o salvoconducto . La circular anterior adolecía de una ilegalidad que nos exponía a permitir la salida de personas sin cumplir con la ley. Como no hay relaciones consulares con Venezuela, la única solución para quienes quieran salir con pasaporte vencido es obtener un salvoconducto. La Cancillería, a través de una resolución, homologará dicho salvoconducto a un documento válido de viaje ”, esgrimió.\n\nEl nuevo documento formal permitirá regularizar la salida de dos grupos específicos. Personas que ingresaron legalmente pero cuya documentación caducó durante su permanencia y migrantes en situación irregular que buscan el abandono voluntario del territorio nacional.\n\nDesde el Ejecutivo lamentaron los inconvenientes sufridos por aquellos pasajeros que no pudieron embarcar en sus vuelos durante las últimas horas, pero enfatizaron que el plan de ordenamiento migratorio encabezado por el Presidente José Antonio Kast se aplicará con estricto apego al marco legal.\n\nFinalmente, el Ministerio del Interior aclaró que todos los ciudadanos que salgan del país mediante este salvoconducto habiendo ingresado de forma irregular mantendrán de forma estricta su sanción administrativa de prohibición de reingreso al territorio chileno.", "ok": true}, {"medio": "Epicentro Chile", "dominio": "epicentrochile.com", "url": "https://www.epicentrochile.com/2026/09/16/salida-con-pasaporte-vencido-subsecretario-maximo-pavez-anuncia-homologacion-de-salvoconducto-para-venezolanos/", "texto": "El subsecretario del Interior, Máximo Pavez, anunció que la salida de ciudadanos venezolanos con documentos vencidos o situación irregular será autorizada mediante la pronta homologación formal de un salvoconducto digital emanado por la Cancillería de Venezuela.\n\nLa autoridad explicó que la actual Ley de Migraciones exige de forma estricta la exhibición de un pasaporte vigente o salvoconducto validado para abandonar el país, motivo por el cual el Ejecutivo procedió el 16 de agosto de 2026 a dejar sin efecto una circular administrativa heredada del gobierno anterior por considerar que adolecía de vicios de ilegalidad.\n\nFrente al escenario de ruptura de relaciones consulares que impide tramitar renovaciones en territorio chileno, el gobierno venezolano solicitó formalmente el reconocimiento de su documento digital de viaje, antecedente que fue remitido de inmediato a la Policía de Investigaciones (PDI) en su rol de ente contralor fronterizo.\n\nEl personero de Gobierno precisó que el Ministerio de Relaciones Exteriores publicará la resolución que otorga validez legal a dicho instrumento entre este miércoles y jueves. “Apenas la Cancillería dicte el acto administrativo correspondiente, este documento permitirá que cualquier ciudadano venezolano pueda retornar a su país de origen, incluso si carece de pasaporte o realizó su ingreso por pasos no habilitados ”, puntualizó Pavez respecto al alcance técnico de la normativa.\n\nLa autoridad recalcó que la ausencia de representaciones consulares directas obligó a coordinar este mecanismo para asegurar que el documento sea aceptado tanto en los controles de salida nacionales como al momento de arribar y ser admitido en Venezuela.\n\nEl titular de la subsecretaría advirtió con firmeza que la facilitación del retorno humanitario no exime la aplicación de las sanciones jurídicas contempladas en el ordenamiento nacional. Quienes hayan entrado a Chile eludiendo el control migratorio y utilicen este mecanismo quedarán sujetos a la medida formal de prohibición de reingreso al territorio, manteniéndose vigentes los decretos respectivos que dicta el Servicio Nacional de Migraciones según el marco legal.\n\nFinalmente, Pavez lamentó los perjuicios experimentados en terminales aéreos por personas que vieron frustrados sus itinerarios con pasajes comprados a raíz de la desinformación inicial, comprometiendo una campaña informativa masiva una vez que concluya el trámite de validación diplomática.\n\nGoogle Comunidad en Facebook: Facebook Reportes por WhatsApp: WhatsApp Suscríbete en YouTube: YouTube\n\nLa medida permitirá que ciudadanos venezolanos abandonen Chile con el documento emitido por su Cancillería, incluso si no cuentan con pasaporte vigente.\n\nLa víctima, de 27 años, falleció en el Hospital de Lota luego de ser atacada por terceros. La PDI quedó a cargo de las diligencias.\n\nEl hallazgo ocurrió durante excavaciones realizadas en medio de las obras de remodelación del recinto. Fiscalía y PDI investigan su origen.\n\nUna investigación coordinada entre la PDI, el Ministerio Público y el Servicio Nacional de Aduanas permitió desarticular por primera vez en el país un laboratorio...", "ok": true}]}, {"id": "94ea01243f24", "titulo_original": "Informe destapa hacinamiento y abusos en otro centro de detención de migrantes en Florida", "url": "https://news.google.com/rss/articles/CBMi_?oc=5", "medios": ["Clarin.com", "Diario Red", "El Universal", "Infobae"], "coberturas": [{"medio": "Clarin.com", "url": "https://news.google.?oc=5", "fecha": "2026-09-17T15:50:07+00:00", "titulo": "Informe destapa hacinamiento y abusos en otro centro de detención de migrantes en Florida"}, {"medio": "Diario Red", "url": "https://news.google.?oc=5", "fecha": "2026-09-17T21:01:30+00:00", "titulo": "Informe federal destapa sobrecupo, abusos y fallas sanitarias en el centro de detención de ICE en Miami"}, {"medio": "El Universal", "url": "https://news.google.com/rss/articles/CBMi_?oc=5", "fecha": "2026-09-17T16:43:00+00:00", "titulo": "Informe destapa hacinamiento y abusos en centro de detención de migrantes en Florida; surge tras denuncias sobre Alligator Alcatraz"}, {"medio": "Infobae", "url": "https://news.google.?oc=5", "fecha": "2026-09-17T15:49:43+00:00", "titulo": "Informe destapa hacinamiento y abusos en otro centro de detención de migrantes en Florida"}], "velocidad": 4, "aceleracion": null, "trends": null, "horas": 7.7, "notas": 5, "otras_urls": ["https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5", "https://news.google.?oc=5"], "ejes": ["deportaciones", "derechos_humanos"], "region": "Norteamérica", "paises": ["US"], "paises_nombres": ["Estados Unidos"], "pais_inferido": false, "fuera_de_alcance": false, "importancia": 9, "clasificado": true, "es_migratorio": true, "poblaciones": [], "colectividades": [], "actores": ["sociedad_civil", "organismos_migratorios"], "etapa": "destino", "tipo": "dato", "cobertura": 4, "confianza": 0.9, "tiene_fuente_primaria": true, "contiene_datos_personales": false, "requiere_verificacion": false, "cobertura_tardia": false, "terminologia_problematica": [], "termino_busqueda": "deportaciones", "angulo_sugerido": "Revisar las recomendaciones del informe sobre condiciones de detención y posibles acciones legales", "nota": "Informe sobre abusos y hacinamiento en centro de detención migratoria.", "fuentes_texto": [{"medio": "Clarin.com", "dominio": "clarin.com", "url": "https://www.clarin.com/estados-unidos/informe-destapa-hacinamiento-y-abusos-en-otro-centro-de-detencion-de-migrantes-en-florida_0_bMeaaU3nFl.html", "texto": "Una investigación del Gobierno de Estados Unidos reveló que el centro de detención para migrantes de Krome, en el sur de Florida, sobrepasó ampliamente su capacidad máxima, una semana después de que otro informe oficial documentara abusos sistemáticos en la instalación 'Alligator Alcatraz'.\n\nEl centro de Krome alojaba a 1.102 detenidos -frente a un límite de 882- cuando los inspectores de la Oficina del Inspector General del Departamento de Seguridad Nacional (DHS, en inglés) realizaron una visita no anunciada al centro en mayo de 2025, según el informe.\n\nEsto supuso un exceso del 25 % sobre su capacidad máxima y obligó a que varios detenidos durmieran en catres temporales en lugar de en camas permanentes debido al hacinamiento.\n\nLa sobrepoblación del lugar derivó en el incumplimiento del número mínimo requerido de inodoros, lavabos y duchas en funcionamiento para los detenidos, según el informe, que registró retrasos considerables en la atención médica ofrecida debido a la escasez de personal.\n\n\"La reciente afluencia de detenidos en Krome aumentó la dificultad para satisfacer las mayores exigencias del equipo médico del centro, lo que provocó retrasos en la prestación de una atención médica oportuna\", explicó el reporte.\n\nLos nuevos detenidos, además, podían llegar a esperar más de doce horas en salas abarrotadas a que los funcionarios procesaran su ingreso.\n\nLa investigación también reveló 44 incidentes de uso de la fuerza por parte del personal desde el 29 de noviembre de 2024 hasta el 28 de mayo de 2025.\n\nDos de ellos fueron especialmente alarmantes, de acuerdo con el informe. El primero implicó el uso de gas pimienta contra un detenido cuando se hallaba dentro de un módulo con más internos y, en el segundo, un oficial \"utilizó indebidamente una llave de estrangulamiento mientras registraba una celda en busca de contrabando\".\n\nAmbos casos representaron un uso desmedido de la fuerza que, según los inspectores, solo debe emplearse en caso de estricta necesidad.\n\nLa seguridad alimentaria fue otro de los problemas identificados durante la visita al lugar, puesto que los oficiales no descongelaban los alimentos correctamente ni almacenaban los productos perecederos a las temperaturas requeridas.\n\nLos inspectores citaron los casos concretos de alimentos con la etiqueta \"mantener congelado\" que se dejó a la intemperie bajo un intenso calor y a la luz directa del sol durante más de dos horas, y de una tina que almacenaba sin tapar pollo crudo en la cocina.\n\nEl informe destaca que el Servicio de Inmigración y Control de Aduanas (ICE, en inglés) aceptó todas las recomendaciones de los inspectores, y en agosto de 2026 proporcionó documentación que acreditaba que el centro ya no operaba por encima de su capacidad.\n\nLos resultados de esta inspección salen a la luz en paralelo a una investigación del mismo organismo que constató condiciones de hacinamiento, abusos y el uso de pequeñas jaulas metálicas como \"zonas de calma\" para los migrantes detenidos en 'Alligator Alcatraz', antes de su cierre a mitad de año en el sur de Florida.\n\nSegún los inspectores, hasta 79 migrantes fueron confinados en ese centro \"entre varios minutos y casi dos horas\" en pequeñas jaulas de 1,7 metros de diámetro entre el 17 de julio de 2025 y el 18 de enero de 2026.\n\nRecibí en tu mail todas las noticias, historias y análisis de los periodistas de Clarín", "ok": true}, {"medio": "El Universal", "dominio": "eluniversal.com.mx", "url": "https://www.eluniversal.com.mx/mundo/informe-destapa-hacinamiento-y-abusos-en-centro-de-detencion-de-migrantes-en-florida-surge-tras-denuncias-sobre-alligator-alcatraz/", "texto": "× Secciones El Universal Nuestros Sitios Multimedia Servicios Club El Universal Descubre y Compra Aviso Oportuno Empleos [Publicidad]\n\nEl centro de Krome, en Florida, alojaba a mil 102 detenidos, frente a un límite de 882. Foto: Ilustrativa / AFP [Publicidad]\n\n​​​​​​​EFE Ver perfil Una investigación del gobierno de Estados Unidos reveló que el centro de detención para migrantes de Krome, en el sur de Florida , sobrepasó ampliamente su capacidad máxima, una semana después de que otro informe oficial documentara abusos sistemáticos en la instalación \" Alligator Alcatraz \".\n\nEl centro de Krome alojaba a mil 102 detenidos -frente a un límite de 882- cuando los inspectores de la Oficina del Inspector General del Departamento de Seguridad Nacional (DHS, en inglés) realizaron una visita no anunciada al centro en mayo de 2025, según el informe.\n\nEsto supuso un exceso del 25% sobre su capacidad máxima y obligó a que varios detenidos durmieran en catres temporales en lugar de en camas permanentes debido al hacinamiento.\n\n\"Aligátor Alcatraz\", enfrenta un 25% de exceso en su población, según un informe. Foto: AFP En Nigeria fallecen 48 personas tras ingerir bebida presuntamente adulterada con metanol; reportan 182 personas afectadas en total La sobrepoblación del lugar derivó en el incumplimiento del número mínimo requerido de inodoros, lavabos y duchas en funcionamiento para los detenidos, según el informe, que registró retrasos considerables en la atención médica ofrecida debido a la escasez de personal.\n\n\"La reciente afluencia de detenidos en Krome aumentó la dificultad para satisfacer las mayores exigencias del equipo médico del centro, lo que provocó retrasos en la prestación de una atención médica oportuna\", explicó el reporte.\n\nLos nuevos detenidos, además, podían llegar a esperar más de doce horas en salas abarrotadas a que los funcionarios procesaran su ingreso.\n\nLa reciente afluencia de detenidos en Krome aumentó la dificultad para satisfacer las mayores exigencias del equipo médico del centro, lo que provocó retrasos en la prestación de una atención médica oportuna. Foto: EFE Venezuela desbloquea medios de comunicación censurados por años; inicia segunda ronda de diálogo entre gobierno y oposición La investigación también reveló 44 incidentes de uso de la fuerza por parte del personal desde el 29 de noviembre de 2024 hasta el 28 de mayo de 2025.\n\nDos de ellos fueron especialmente alarmantes, de acuerdo con el informe. El primero implicó el uso de gas pimienta contra un detenido cuando se hallaba dentro de un módulo con más internos y, en el segundo, un oficial \"utilizó indebidamente una llave de estrangulamiento mientras registraba una celda en busca de contrabando\".\n\nAmbos casos representaron un uso desmedido de la fuerza que, según los inspectores, solo debe emplearse en caso de estricta necesidad.\n\nUna investigación del Gobierno de Estados Unidos reveló que el centro de detención para migrantes de Krome, en el sur de Florida, sobrepasó ampliamente su capacidad máxima. Foto: AFP La seguridad alimentaria fue otro de los problemas identificados durante la visita al lugar, puesto que los oficiales no descongelaban los alimentos correctamente ni almacenaban los productos perecederos a las temperaturas requeridas.\n\nLos inspectores citaron los casos concretos de alimentos con la etiqueta \"mantener congelado\" que se dejó a la intemperie bajo un intenso calor y a la luz directa del sol durante más de dos horas, y de una tina que almacenaba sin tapar pollo crudo en la cocina.\n\nEl informe destaca que el Servicio de Inmigración y Control de Aduanas (ICE, en inglés) aceptó todas las recomendaciones de los inspectores, y en agosto de 2026 proporcionó documentación que acreditaba que el centro ya no operaba por encima de su capacidad.\n\nSegún los inspectores, hasta 79 migrantes fueron confinados en ese centro Foto: AFP/JESUS OLARTE Crece polémica sobre el Centro Kennedy; ¿Trump planea demoler el famoso recinto de artes escénicas de EU? Los ", "ok": true}, {"medio": "Infobae", "dominio": "infobae.com", "url": "https://www.infobae.com/america/agencias/2026/09/17/informe-destapa-hacinamiento-y-abusos-en-otro-centro-de-detencion-de-migrantes-en-florida/?outputType=amp-type", "texto": "Miami (EE.UU.), 17 sep (EFE).- Una investigaci&oacute;n del Gobierno de Estados Unidos revel&oacute; que el centro de detenci&oacute;n para migrantes de Krome, en el sur de Florida, sobrepas&oacute; ampliamente su capacidad m&aacute;xima, una semana despu&eacute;s de que otro informe oficial documentara abusos sistem&aacute;ticos en la instalaci&oacute;n &#39;Alligator Alcatraz&#39;.\n\nEl centro de Krome alojaba a 1.102 detenidos -frente a un l&iacute;mite de 882- cuando los inspectores de la Oficina del Inspector General del Departamento de Seguridad Nacional (DHS, en ingl&eacute;s) realizaron una visita no anunciada al centro en mayo de 2025, seg&uacute;n el informe.\n\nEsto supuso un exceso del 25 % sobre su capacidad m&aacute;xima y oblig&oacute; a que varios detenidos durmieran en catres temporales en lugar de en camas permanentes debido al hacinamiento.\n\nLa sobrepoblaci&oacute;n del lugar deriv&oacute; en el incumplimiento del n&uacute;mero m&iacute;nimo requerido de inodoros, lavabos y duchas en funcionamiento para los detenidos, seg&uacute;n el informe, que registr&oacute; retrasos considerables en la atenci&oacute;n m&eacute;dica ofrecida debido a la escasez de personal.\n\n&quot;La reciente afluencia de detenidos en Krome aument&oacute; la dificultad para satisfacer las mayores exigencias del equipo m&eacute;dico del centro, lo que provoc&oacute; retrasos en la prestaci&oacute;n de una atenci&oacute;n m&eacute;dica oportuna&quot;, explic&oacute; el reporte.\n\nLos nuevos detenidos, adem&aacute;s, pod&iacute;an llegar a esperar m&aacute;s de doce horas en salas abarrotadas a que los funcionarios procesaran su ingreso.\n\nLa investigaci&oacute;n tambi&eacute;n revel&oacute; 44 incidentes de uso de la fuerza por parte del personal desde el 29 de noviembre de 2024 hasta el 28 de mayo de 2025.\n\nDos de ellos fueron especialmente alarmantes, de acuerdo con el informe. El primero implic&oacute; el uso de gas pimienta contra un detenido cuando se hallaba dentro de un m&oacute;dulo con m&aacute;s internos y, en el segundo, un oficial &quot;utiliz&oacute; indebidamente una llave de estrangulamiento mientras registraba una celda en busca de contrabando&quot;.\n\nAmbos casos representaron un uso desmedido de la fuerza que, seg&uacute;n los inspectores, solo debe emplearse en caso de estricta necesidad.\n\nLa seguridad alimentaria fue otro de los problemas identificados durante la visita al lugar, puesto que los oficiales no descongelaban los alimentos correctamente ni almacenaban los productos perecederos a las temperaturas requeridas.\n\nLos inspectores citaron los casos concretos de alimentos con la etiqueta &quot;mantener congelado&quot; que se dej&oacute; a la intemperie bajo un intenso calor y a la luz directa del sol durante m&aacute;s de dos horas, y de una tina que almacenaba sin tapar pollo crudo en la cocina.\n\nEl informe destaca que el Servicio de Inmigraci&oacute;n y Control de Aduanas (ICE, en ingl&eacute;s) acept&oacute; todas las recomendaciones de los inspectores, y en agosto de 2026 proporcion&oacute; documentaci&oacute;n que acreditaba que el centro ya no operaba por encima de su capacidad.\n\nLos resultados de esta inspecci&oacute;n salen a la luz en paralelo a una investigaci&oacute;n del mismo organismo que constat&oacute; condiciones de hacinamiento, abusos y el uso de peque&ntilde;as jaulas met&aacute;licas como &quot;zonas de calma&quot; para los migrantes detenidos en &#39;Alligator Alcatraz&#39;, antes de su cierre este verano en el sur de Florida.\n\nSeg&uacute;n los inspectores, hasta 79 migrantes fueron confinados en ese centro &quot;entre varios minutos y casi dos horas&quot; en peque&ntilde;as jaulas de 1,7 metros de di&aacute;metro entre el 17 de julio de 2025 y el 18 de enero de 2026.EFE", "ok": true}]}, {"id": "be7a7d6b6caa", "titulo_original": "Gobierno de Perú detendrá a migrantes irregulares en instalaciones militares en desuso", "url": "https://news.google.com/rss/articles/CBMiyAFBVV95cUxOdS1QdGVrZTFPRDl3cC1uOWhkZk80ZlpTNS15aGNydU8za2dUekM0RVFldC1vZmdWaXJYTldoa3JQRkFuQ2NCTUVINzgzUzlYekY3SmlSYWc0Y2ZJZkltZTd3cllYTE10OW9uSG9rT3dWdUVRYzlKN2RVcGU1T2lJWDZ2N0lkSFROaWpvWlB4bHpVOTRVcWdwX2gtYzVnbGlES3ZTcUJqSWh6SGY3elNiWDZQQmdrdk5WamxoRVMzRUs5Qk9BeW4xRA?oc=5", "medios": ["NODAL - Noticias de América Latina y el Caribe", "nodal.am", "Prensa Latina", "teleSUR"], "coberturas": [{"medio": "NODAL - Noticias de América Latina y el Caribe", "url": "https://news.google.com/rss/articles/CBMiyAFBVV95cUxOdS1QdGVrZTFPRDl3cC1uOWhkZk80ZlpTNS15aGNydU8za2dUekM0RVFldC1vZmdWaXJYTldoa3JQRkFuQ2NCTUVINzgzUzlYekY3SmlSYWc0Y2ZJZkltZTd3cllYTE10OW9uSG9rT3dWdUVRYzlKN2RVcGU1T2lJWDZ2